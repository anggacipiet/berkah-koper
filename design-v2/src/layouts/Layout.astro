---
import '../styles/theme.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Berkah Koper — Katalog 2026',
  description = 'Supplier koper & tas Haji Umrah. Kalideres, Jakarta Barat. Custom logo, harga pabrik.',
  image = '/og-image.jpg',
} = Astro.props;

const WA = 'https://wa.me/6285282400061?text=Assalamu%27alaikum%20Berkah%20Koper%2C%20saya%20ingin%20tanya%20produk.';
const nav = [
  { href: '/', label: 'Beranda' },
  { href: '/katalog', label: 'Katalog' },
  { href: '/#bundling', label: 'Bundling' },
  { href: '/#tentang', label: 'Tentang' },
];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <link rel="icon" type="image/webp" href="/images/logo.webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="v2-root">
    <header class="sticky top-0 z-40 border-b border-[rgba(201,164,72,0.22)] bg-[#0a0a0a]/92 backdrop-blur">
      <div class="v2-wrap flex h-[4.25rem] items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-3" aria-label="Berkah Koper">
          <img src="/images/logo.webp" alt="" class="size-10 rounded-xl object-contain" width="40" height="40" />
          <span>
            <span class="v2-serif block text-xl font-semibold leading-none text-[var(--gold)]">Berkah Koper</span>
            <span class="text-[10px] font-semibold uppercase tracking-[0.18em] text-[var(--gold-deep)]">Katalog 2026</span>
          </span>
        </a>
        <nav class="hidden items-center gap-7 text-sm font-medium text-[#f4ead2]/80 md:flex" aria-label="Utama">
          {nav.map((l) => (
            <a href={l.href} class="hover:text-[var(--gold)]">{l.label}</a>
          ))}
        </nav>
        <div class="flex items-center gap-2">
          <a href={WA} class="v2-btn v2-btn-gold hidden sm:inline-flex" target="_blank" rel="noopener noreferrer">WhatsApp</a>
          <button
            id="v2-menu-btn"
            class="grid size-10 place-items-center rounded-full border border-[rgba(201,164,72,0.35)] text-[var(--gold)] md:hidden"
            aria-label="Buka menu"
            aria-expanded="false"
            aria-controls="v2-mobile"
            type="button"
          >
            <span class="text-lg leading-none">☰</span>
          </button>
        </div>
      </div>
      <nav id="v2-mobile" class="hidden border-t border-[rgba(201,164,72,0.18)] bg-[#0a0a0a] px-5 py-3 md:hidden">
        {nav.map((l) => (
          <a href={l.href} class="block py-2 text-sm font-medium text-[#f4ead2]">{l.label}</a>
        ))}
        <a href={WA} class="v2-btn v2-btn-navy mt-2 w-full" target="_blank" rel="noopener noreferrer">WhatsApp</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-8 border-t border-[rgba(201,164,72,0.25)] bg-[#050505] text-[#e8e2d4]">
      <div class="v2-wrap grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <div class="v2-serif text-2xl text-[var(--gold)]">Berkah Koper</div>
          <p class="mt-3 max-w-xs text-sm leading-6 text-white/65">
            Supplier koper dan tas Umroh di Kalideres, Jakarta Barat. Bahan ABS, PC, dan PP anti pecah. Custom logo kloter.
          </p>
        </div>
        <div>
          <div class="text-xs font-semibold uppercase tracking-widest text-[var(--gold)]">Produk</div>
          <ul class="mt-4 space-y-2 text-sm text-white/70">
            <li><a href="/katalog?kategori=koper">Koper</a></li>
            <li><a href="/katalog?kategori=tas-paspor">Tas paspor & selempang</a></li>
            <li><a href="/katalog?kategori=bundling">Paket bundling</a></li>
          </ul>
        </div>
        <div>
          <div class="text-xs font-semibold uppercase tracking-widest text-[var(--gold)]">Navigasi</div>
          <ul class="mt-4 space-y-2 text-sm text-white/70">
            <li><a href="/">Beranda</a></li>
            <li><a href="/katalog">Katalog</a></li>
          </ul>
        </div>
        <div>
          <div class="text-xs font-semibold uppercase tracking-widest text-[var(--gold)]">Kontak</div>
          <ul class="mt-4 space-y-2 text-sm text-white/70">
            <li><a href="https://wa.me/6285282400061" target="_blank" rel="noopener noreferrer">0852-8240-0061</a></li>
            <li>Kalideres, Jakarta Barat</li>
            <li>Senin–Sabtu, 08.00–20.00 WIB</li>
          </ul>
        </div>
      </div>
      <div class="border-t border-white/10 py-4 text-center text-xs text-white/40">© 2026 Berkah Koper · desain baru (pratinjau)</div>
    </footer>

    <a href={WA} class="v2-float" target="_blank" rel="noopener noreferrer" aria-label="Chat WhatsApp">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      <span class="hidden sm:inline">Chat</span>
    </a>

    <script>
      const btn = document.getElementById('v2-menu-btn');
      const menu = document.getElementById('v2-mobile');
      btn?.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!open));
        menu?.classList.toggle('hidden');
      });
    </script>
  </body>
</html>
