---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import BundleCard from '../components/BundleCard.astro';
import { getFeaturedProducts, getBundleProducts } from '../data/products';
import { bk26, k26 } from '../data/catalog';

const featured = getFeaturedProducts(8);
const bundles = getBundleProducts();

const why = [
  { n: '01', t: 'Kualitas premium', d: 'ABS, Polycarbonate, dan Polypropylene yang kuat.' },
  { n: '02', t: 'Desain fungsional', d: 'Ruang optimal untuk ihram dan perlengkapan jamaah.' },
  { n: '03', t: 'Ringan & nyaman', d: 'Roda silent 360° untuk bandara dan area ibadah.' },
  { n: '04', t: 'Aman', d: 'Kunci kombinasi 3-digit dan custom logo kloter.' },
];
---

<Layout title="Berkah Koper — Desain baru">
  <section class="v2-hero">
    <div class="v2-wrap grid items-center gap-12 py-16 lg:grid-cols-2 lg:py-24">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[var(--gold-deep)]">Supplier Haji & Umrah · Kalideres</p>
        <h1 class="v2-serif mt-4 max-w-xl text-5xl leading-[1.05] text-[var(--gold)] md:text-6xl">
          Koleksi koper,<br />disiapkan dengan tenang.
        </h1>
        <p class="mt-5 max-w-md text-base leading-7 text-[var(--muted)]">
          Mengikuti katalog resmi 2026: koper PP anti pecah, ABS/PC, tas paspor & selempang custom logo.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/katalog" class="v2-btn v2-btn-gold">Lihat katalog</a>
          <a href="https://wa.me/6285282400061?text=Assalamu%27alaikum%20Berkah%20Koper" class="v2-btn v2-btn-ghost" target="_blank" rel="noopener noreferrer">Konsultasi</a>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <img src={k26(1)} alt="Koleksi koper Berkah Koper" class="h-72 w-full rounded-[1.75rem] object-cover ring-1 ring-[rgba(201,164,72,0.28)] lg:h-[22rem]" width="480" height="352" />
        <div class="flex flex-col gap-3 pt-8">
          <img src={bk26(4)} alt="Koper ABS stripe" class="h-40 w-full rounded-[1.5rem] object-cover object-top ring-1 ring-[rgba(201,164,72,0.28)]" width="320" height="160" />
          <img src={bk26(21)} alt="Tas paspor custom" class="h-40 w-full rounded-[1.5rem] object-cover object-top ring-1 ring-[rgba(201,164,72,0.28)]" width="320" height="160" />
        </div>
      </div>
    </div>
  </section>

  <section class="py-10">
    <div class="v2-wrap grid grid-cols-2 gap-3 sm:grid-cols-4">
      {[
        ['Koper', '/katalog?kategori=koper'],
        ['Tas paspor', '/katalog?kategori=tas-paspor'],
        ['Bundling', '/katalog?kategori=bundling'],
        ['Semua', '/katalog'],
      ].map(([label, href]) => (
        <a href={href} class="rounded-2xl bg-[#141414] px-4 py-5 text-center text-sm font-semibold text-[var(--gold)] ring-1 ring-[rgba(201,164,72,0.2)] hover:ring-[var(--gold)]">{label}</a>
      ))}
    </div>
  </section>

  <section class="py-8">
    <div class="v2-wrap">
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-[var(--gold-deep)]">Unggulan</p>
          <h2 class="v2-serif mt-1 text-4xl text-[var(--navy)]">Dari katalog 2026</h2>
        </div>
        <a href="/katalog" class="v2-btn v2-btn-ghost text-sm">Semua produk</a>
      </div>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {featured.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <section id="bundling" class="py-16">
    <div class="v2-wrap">
      <p class="text-xs font-semibold uppercase tracking-widest text-[var(--gold-deep)]">Paket</p>
      <h2 class="v2-serif mt-1 text-4xl text-[var(--navy)]">Bundling hemat</h2>
      <div class="mt-8 flex flex-col gap-6">
        {bundles.map((p) => <BundleCard product={p} />)}
      </div>
    </div>
  </section>

  <section id="tentang" class="border-y border-[rgba(201,164,72,0.18)] bg-[#111] py-16">
    <div class="v2-wrap grid gap-10 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-[var(--gold-deep)]">Tentang</p>
        <h2 class="v2-serif mt-2 text-4xl text-[var(--navy)]">Mengapa Berkah Koper</h2>
        <p class="mt-4 max-w-md leading-7 text-[var(--muted)]">
          Spesialis koper dan tas Umroh di Kalideres, Jakarta Barat. Fokus pada ketahanan material, keamanan, dan desain yang terorganisir untuk jamaah.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {why.map((w) => (
          <div class="rounded-2xl bg-[#0a0a0a] p-5 ring-1 ring-[rgba(201,164,72,0.16)]">
            <div class="text-xs font-semibold text-[var(--gold-deep)]">{w.n}</div>
            <h3 class="mt-2 font-semibold text-[var(--navy)]">{w.t}</h3>
            <p class="mt-1 text-sm leading-6 text-[var(--muted)]">{w.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
