---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import ColorPicker from '../../components/ColorPicker.astro';
import {
  getAllProducts,
  getProductBySlug,
  buildWaMessage,
  getProductsByCategory,
} from '../../data/products';
import { CATEGORY_LABELS } from '../../types/product';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () =>
  getAllProducts().map((p) => ({ params: { slug: p.slug } }));

const { slug } = Astro.params;
const product = getProductBySlug(slug!);
if (!product) return Astro.redirect('/katalog');

const {
  name, category, description, images,
  badge, colorGroups, features, weight, material,
  sizes, inStock, isBundle, bundleItems,
} = product;

const waBase = `https://wa.me/6285282400061?text=${buildWaMessage(product)}`;
const catLabel = (CATEGORY_LABELS[category] ?? category).replace(/^[^ ]+ /, '');
const related = getProductsByCategory(category).filter((p) => p.slug !== slug).slice(0, 4);
---

<Layout title={`${name} — Berkah Koper`} description={product.shortDesc} image={images[0]}>
  <div class="v2-wrap py-10">
    <nav class="mb-6 text-xs text-[var(--muted)]" aria-label="Breadcrumb">
      <a href="/">Beranda</a> / <a href="/katalog">Katalog</a> / {name}
    </nav>

    <div class="overflow-hidden rounded-[2rem] bg-[#141414] ring-1 ring-[rgba(201,164,72,0.22)]">
      <div class="grid lg:grid-cols-2">
        <div class="bg-[#111] p-6">
          {badge && <span class="v2-badge">{badge}</span>}
          <div class="mt-3 aspect-square overflow-hidden rounded-2xl bg-[#0a0a0a]">
            {images[0] && (
              <img id="main-img" src={images[0]} alt={name} class="h-full w-full object-cover" width="600" height="600" />
            )}
          </div>
          {images.length > 1 && (
            <div class="mt-3 flex gap-2 overflow-x-auto">
              {images.map((src) => (
                <button type="button" class="thumb-btn overflow-hidden rounded-xl ring-1 ring-white/10" data-src={src}>
                  <img src={src} alt="" class="size-16 object-cover" width="64" height="64" loading="lazy" />
                </button>
              ))}
            </div>
          )}
        </div>

        <div class="flex flex-col gap-5 p-6 lg:p-8">
          <div>
            <div class="text-xs font-semibold uppercase tracking-widest text-[var(--gold-deep)]">{catLabel}</div>
            <h1 class="v2-serif mt-1 text-4xl text-[var(--navy)]">{name}</h1>
          </div>
          <div class="rounded-2xl bg-[#0a0a0a] p-4 ring-1 ring-[rgba(201,164,72,0.22)]">
            <div class="text-sm font-semibold text-[var(--navy)]">Harga & pemesanan</div>
            <p class="mt-1 text-sm text-[var(--muted)]">Hubungi WhatsApp untuk harga terkini dan stok.</p>
          </div>
          <p class="leading-7 text-[var(--muted)]">{description}</p>

          {sizes && sizes.length > 0 && (
            <div>
              <div class="mb-2 text-sm font-semibold text-[var(--navy)]">
                Ukuran <span id="size-selected-label" class="font-normal text-[var(--muted)]">— belum dipilih</span>
              </div>
              <div class="flex flex-wrap gap-2" role="radiogroup" aria-label="Ukuran">
                {sizes.map((sz) => (
                  <button type="button" role="radio" aria-checked="false" data-size={sz} class="size-btn rounded-full border border-[rgba(201,164,72,0.3)] px-4 py-2 text-sm font-semibold text-[var(--gold)] aria-checked:border-[var(--gold)] aria-checked:bg-[rgba(201,164,72,0.15)]">
                    {sz}
                  </button>
                ))}
              </div>
            </div>
          )}

          {colorGroups && colorGroups.length > 0 && (
            <ColorPicker colorGroups={colorGroups} productName={name} />
          )}

          {isBundle && bundleItems && (
            <ul class="space-y-1 text-sm">
              {bundleItems.map((item) => <li>▸ {item}</li>)}
            </ul>
          )}

          {features && (
            <ul class="grid gap-1.5 text-sm text-[var(--muted)] sm:grid-cols-2">
              {features.map((f) => <li>— {f}</li>)}
            </ul>
          )}

          {(weight || material) && (
            <dl class="grid grid-cols-2 gap-2 text-sm">
              {weight && <><dt class="text-[var(--muted)]">Berat</dt><dd>{weight}</dd></>}
              {material && <><dt class="text-[var(--muted)]">Bahan</dt><dd>{material}</dd></>}
            </dl>
          )}

          <div class="mt-auto flex flex-col gap-2 border-t border-[rgba(201,164,72,0.18)] pt-4 sm:flex-row">
            {inStock ? (
              <a id="wa-btn" href={waBase} data-wa-base={waBase} class="v2-btn v2-btn-gold flex-1" target="_blank" rel="noopener noreferrer">Beli via WhatsApp</a>
            ) : (
              <button disabled class="v2-btn v2-btn-ghost flex-1 opacity-40">Stok habis</button>
            )}
            <a href="/katalog" class="v2-btn v2-btn-ghost flex-1">Katalog</a>
          </div>
        </div>
      </div>
    </div>

    {related.length > 0 && (
      <section class="mt-14">
        <h2 class="v2-serif text-3xl text-[var(--navy)]">Produk serupa</h2>
        <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {related.map((p) => <ProductCard product={p} />)}
        </div>
      </section>
    )}
  </div>
</Layout>

<script>
  const mainImg = document.getElementById('main-img') as HTMLImageElement | null;
  document.querySelectorAll<HTMLButtonElement>('.thumb-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const src = btn.dataset.src;
      if (mainImg && src) mainImg.src = src;
    });
  });
  const sizeLabel = document.getElementById('size-selected-label');
  const waBtn = document.getElementById('wa-btn') as HTMLAnchorElement | null;
  document.querySelectorAll<HTMLButtonElement>('.size-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.size-btn').forEach((b) => b.setAttribute('aria-checked', 'false'));
      btn.setAttribute('aria-checked', 'true');
      const size = btn.dataset.size ?? '';
      if (sizeLabel) sizeLabel.textContent = size;
      if (waBtn) {
        const base = waBtn.dataset.waBase ?? '';
        waBtn.href = base.replace(/%0A%0AUkuran[^&]*/g, '') + encodeURIComponent(`\n\nUkuran: ${size}`);
      }
    });
  });
</script>
