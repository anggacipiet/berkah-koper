---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import SearchBar from '../components/SearchBar.astro';
import { getAllProducts } from '../data/products';
import type { ProductCategory } from '../types/product';
import { CATEGORY_LABELS } from '../types/product';

const kategori = Astro.url.searchParams.get('kategori') ?? 'semua';
const q = (Astro.url.searchParams.get('q') ?? '').trim().toLowerCase();

let products = getAllProducts();
if (kategori && kategori !== 'semua') products = products.filter((p) => p.category === kategori);
if (q) {
  products = products.filter(
    (p) => p.name.toLowerCase().includes(q) || p.shortDesc.toLowerCase().includes(q),
  );
}

const katLabel = kategori !== 'semua'
  ? (CATEGORY_LABELS[kategori as ProductCategory] ?? kategori).replace(/^[^ ]+ /, '')
  : 'Semua produk';
---

<Layout title={`${katLabel} — Katalog Berkah Koper`}>
  <div class="v2-wrap py-10">
    <nav class="mb-3 text-xs text-[var(--muted)]" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[var(--gold)]">Beranda</a>
      <span> / </span>
      <span>Katalog</span>
    </nav>
    <h1 class="v2-serif text-4xl text-[var(--navy)]">{q ? `Hasil “${q}”` : katLabel}</h1>
    <p class="mt-1 text-sm text-[var(--muted)]">{products.length} produk</p>

    <div class="mt-6 flex flex-col gap-4">
      <SearchBar value={q} action="/katalog" />
      <CategoryFilter basePath="/katalog" />
    </div>

    {products.length > 0 ? (
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {products.map((p) => <ProductCard product={p} />)}
      </div>
    ) : (
      <div class="mt-16 text-center">
        <h2 class="v2-serif text-3xl text-[var(--navy)]">Tidak ditemukan</h2>
        <a href="/katalog" class="v2-btn v2-btn-navy mt-4">Lihat semua</a>
      </div>
    )}
  </div>
</Layout>
