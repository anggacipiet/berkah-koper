---
import type { Product } from '../types/product';
import { buildWaMessage } from '../data/products';

interface Props { product: Product; }
const { product } = Astro.props;
const { slug, name, category, shortDesc, images, badge, inStock } = product;
const waUrl = `https://wa.me/6285282400061?text=${buildWaMessage(product)}`;
---

<article class="group flex flex-col overflow-hidden rounded-3xl bg-[#141414] ring-1 ring-[rgba(201,164,72,0.18)] transition hover:-translate-y-1 hover:ring-[var(--gold)]">
  <a href={`/produk/${slug}`} class="relative block aspect-[4/3] overflow-hidden bg-[#111]" aria-label={`Lihat ${name}`}>
    {images[0] && (
      <img src={images[0]} alt={name} class="h-full w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" decoding="async" width="400" height="300" />
    )}
    {badge && <span class="v2-badge absolute left-3 top-3">{badge}</span>}
    {!inStock && (
      <div class="absolute inset-0 grid place-items-center bg-black/70 text-xs font-semibold uppercase tracking-widest text-[var(--gold)]">Stok habis</div>
    )}
  </a>
  <div class="flex flex-1 flex-col p-4">
    <div class="text-[10px] font-semibold uppercase tracking-[0.16em] text-[var(--gold-deep)]">{category.replace(/-/g, ' ')}</div>
    <h3 class="v2-serif mt-1 text-xl leading-snug text-[var(--navy)]">
      <a href={`/produk/${slug}`} class="hover:text-[var(--gold-deep)]">{name}</a>
    </h3>
    <p class="mt-1 line-clamp-2 text-sm leading-5 text-[var(--muted)]">{shortDesc}</p>
    <div class="mt-auto pt-4">
      {inStock ? (
        <a href={waUrl} class="v2-btn v2-btn-ghost w-full text-xs" target="_blank" rel="noopener noreferrer" aria-label={`Tanya harga ${name}`}>Tanya harga</a>
      ) : (
        <div class="py-2 text-center text-xs text-[var(--muted)]">Stok habis</div>
      )}
    </div>
  </div>
</article>
