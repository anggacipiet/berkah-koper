---
import type { Product } from '../types/product';
import { buildWaMessage } from '../data/products';

interface Props { product: Product; }
const { product } = Astro.props;
const { slug, name, shortDesc, images, badge, bundleItems = [] } = product;
const waUrl = `https://wa.me/6285282400061?text=${buildWaMessage(product)}`;
---

<article class="overflow-hidden rounded-[2rem] bg-[var(--paper)] ring-1 ring-[rgba(196,163,90,0.35)]">
  <div class="grid lg:grid-cols-2">
    <div class="relative min-h-56 overflow-hidden bg-[#111]">
      {images[0] && <img src={images[0]} alt={name} class="h-full w-full object-cover" loading="lazy" decoding="async" width="600" height="400" />}
      {badge && <span class="v2-badge absolute left-4 top-4">{badge}</span>}
    </div>
    <div class="flex flex-col gap-4 p-6 lg:p-8">
      <div>
        <div class="text-xs font-semibold uppercase tracking-widest text-[var(--gold-deep)]">Paket bundling</div>
        <h3 class="v2-serif mt-1 text-3xl text-[var(--navy)]">
          <a href={`/produk/${slug}`}>{name}</a>
        </h3>
        <p class="mt-2 text-sm leading-6 text-[var(--muted)]">{shortDesc}</p>
      </div>
      {bundleItems.length > 0 && (
        <ul class="space-y-1.5 text-sm text-[var(--ink)]">
          {bundleItems.map((item) => (
            <li class="flex gap-2"><span class="text-[var(--gold-deep)]">▸</span>{item}</li>
          ))}
        </ul>
      )}
      <div class="mt-auto flex flex-wrap gap-2 pt-2">
        <a href={`/produk/${slug}`} class="v2-btn v2-btn-ghost text-sm">Lihat detail</a>
        <a href={waUrl} class="v2-btn v2-btn-gold text-sm" target="_blank" rel="noopener noreferrer">Pesan</a>
      </div>
    </div>
  </div>
</article>
