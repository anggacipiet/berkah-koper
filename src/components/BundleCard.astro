---
import type { Product } from '../types/product';
import { buildWaUrl } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const { slug, name, shortDesc, images, badge, bundleItems = [], features = [] } = product;
const waUrl = buildWaUrl(product);
---

<article class="card-lift group overflow-hidden rounded-3xl border border-[#c9a448]/25 bg-[#111111] shadow-md">
  <div class="grid lg:grid-cols-[1fr_1.1fr]">

    <!-- Gambar -->
    <div class="img-zoom relative aspect-video overflow-hidden bg-[#1a1a1a] lg:aspect-auto">
      {images[0] ? (
        <img
          src={images[0]}
          alt={name}
          class="h-full w-full object-cover"
          loading="lazy"
          decoding="async"
          width="600"
          height="400"
        />
      ) : (
        <div class="flex h-full min-h-52 items-center justify-center text-6xl">📦</div>
      )}
      <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent lg:bg-gradient-to-r"></div>
      {badge && (
        <div class="absolute left-4 top-4">
          <span class="badge badge-gold">{badge}</span>
        </div>
      )}
    </div>

    <!-- Konten -->
    <div class="flex flex-col gap-5 p-6 lg:p-8">
      <div>
        <div class="text-xs font-bold uppercase tracking-widest text-[#c9a448]">Paket Bundling</div>
        <h3 class="mt-2 text-2xl font-black leading-snug text-white">
          <a href={`/produk/${slug}`} class="hover:text-[#c9a448] transition-colors">{name}</a>
        </h3>
        <p class="mt-2 text-sm leading-7 text-white/50">{shortDesc}</p>
      </div>

      {bundleItems.length > 0 && (
        <div>
          <div class="mb-2 text-xs font-bold uppercase tracking-wider text-white/40">Isi Paket</div>
          <ul class="space-y-1.5">
            {bundleItems.map((item) => (
              <li class="flex items-start gap-2 text-sm leading-6 text-white/70">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 size-4 shrink-0 text-[#c9a448]" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      )}

      {features.length > 0 && (
        <div class="rounded-2xl border border-[#c9a448]/15 bg-[#c9a448]/8 p-4">
          <ul class="space-y-1">
            {features.map((f) => (
              <li class="flex items-start gap-2 text-xs text-[#c9a448]/90">
                <span aria-hidden="true">✦</span>
                {f}
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- CTA -->
      <div class="mt-auto flex items-center gap-2 border-t border-white/10 pt-4">
        <a href={`/produk/${slug}`} class="btn-outline-gold shrink-0 px-3 py-2 text-xs sm:px-4 sm:text-sm">Detail</a>
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-wa flex-1 justify-center px-3 py-2 text-xs sm:px-4 sm:text-sm"
          aria-label={`Tanya harga ${name} via WhatsApp`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-3.5 shrink-0" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span class="hidden sm:inline">Pesan Sekarang</span>
          <span class="sm:hidden">Pesan</span>
        </a>
      </div>
    </div>
  </div>
</article>
