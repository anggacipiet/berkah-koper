---
import type { Product } from '../types/product';
import { buildWaUrl } from '../data/products';
import { responsiveImage } from '../lib/media';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const { slug, name, shortDesc, images, badge, bundleItems = [], features = [] } = product;
const waUrl = buildWaUrl(product);
const thumb = images[0] ? responsiveImage(images[0], '(max-width: 1024px) 100vw, 560px') : null;
---

<article class="grid border border-[#e8e8e8] bg-white transition-[border-color,box-shadow] hover:border-[#c9a448] hover:shadow-[0_16px_32px_rgba(17,17,17,0.06)] lg:grid-cols-[0.92fr_1.08fr]">
  <div class="relative min-h-56 overflow-hidden border-b border-[#e8e8e8] bg-white lg:min-h-full lg:border-b-0 lg:border-r">
    {thumb ? (
      <img
        src={thumb.src}
        srcset={thumb.srcset}
        sizes="(max-width: 1024px) 100vw, 480px"
        alt={name}
        class="h-full w-full object-cover object-center"
        loading="lazy"
        decoding="async"
        width="600"
        height="400"
      />
    ) : (
      <div class="flex h-full min-h-52 items-center justify-center text-6xl">📦</div>
    )}
    {badge && (
      <div class="absolute left-4 top-4 z-10">
        <span class="badge badge-gold">{badge}</span>
      </div>
    )}
  </div>

  <div class="flex flex-col gap-5 p-6 lg:p-8">
    <div>
      <div class="text-[10px] font-bold uppercase tracking-[.18em] text-[#c9a448]">Paket Bundling</div>
      <h3 class="mt-2 font-display text-3xl font-semibold leading-snug text-[#161412]">
        <a href={`/produk/${slug}`} class="transition-colors hover:text-[#c9a448]">{name}</a>
      </h3>
      <p class="mt-2 text-sm leading-7 text-[#5c5854]">{shortDesc}</p>
    </div>

    {bundleItems.length > 0 && (
      <div>
        <div class="mb-2 text-[10px] font-bold uppercase tracking-[.16em] text-[#c9a448]">Isi Paket</div>
        <ul class="space-y-1.5">
          {bundleItems.map((item, i) => (
            <li class="flex items-start gap-3 text-sm leading-6 text-[#161412]">
              <span class="mt-0.5 font-display text-sm text-[#c9a448]" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    )}

    {features.length > 0 && (
      <ul class="space-y-1 border-t border-[#e8e8e8] pt-4">
        {features.map((f) => (
          <li class="flex items-start gap-2 text-xs leading-5 text-[#5c5854]">
            <span class="text-[#c9a448]" aria-hidden="true">—</span>
            {f}
          </li>
        ))}
      </ul>
    )}

    <div class="mt-auto flex items-center gap-2 pt-2">
      <a
        href={`/produk/${slug}`}
        class="inline-flex items-center justify-center rounded-full border border-[#c9a448] bg-transparent px-4 py-2 text-xs font-semibold text-[#161412] no-underline transition hover:bg-[#c9a448] hover:text-[#111] sm:text-sm"
        aria-label={`Detail ${name}`}
      >
        Detail
      </a>
      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary flex-1 justify-center px-4 py-2 text-xs sm:text-sm"
        aria-label={`Tanya harga ${name} via WhatsApp`}
      >
        Pesan Sekarang
      </a>
    </div>
  </div>
</article>
