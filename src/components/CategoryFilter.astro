---
interface Props {
  basePath?: string;
}

const { basePath = '/katalog' } = Astro.props;

const allCategories = [
  { value: 'semua',     label: 'Semua Produk' },
  { value: 'koper',     label: 'Koper' },
  { value: 'tas-kabin', label: 'Tas Kabin' },
  { value: 'tas-paspor-selempang', label: 'Tas Paspor/Selempang' },
  { value: 'tas-sandal', label: 'Tas Sandal' },
];
---

<div class="flex flex-wrap gap-2" role="list" aria-label="Filter kategori produk" id="category-filter">
  {allCategories.map(({ value, label }) => {
    const href = value === 'semua' ? basePath : `${basePath}?kategori=${value}`;
    return (
      <a href={href} role="listitem" data-kategori={value} class="filter-chip">
        {label}
      </a>
    );
  })}
</div>

<script>
  function setActiveChip() {
    const params = new URLSearchParams(window.location.search);
    const aktif  = params.get('kategori') ?? 'semua';
    document.querySelectorAll<HTMLAnchorElement>('#category-filter .filter-chip').forEach((chip) => {
      const val = chip.dataset.kategori ?? '';
      chip.classList.toggle('active', val === aktif);
      val === aktif ? chip.setAttribute('aria-current','page') : chip.removeAttribute('aria-current');
    });
  }
  setActiveChip();
  window.addEventListener('popstate', setActiveChip);
</script>
