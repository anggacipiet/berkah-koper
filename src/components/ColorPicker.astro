---
import type { ColorGroup } from '../types/product';

interface Props {
  colorGroups: ColorGroup[];
  productName: string;
}

const { colorGroups, productName } = Astro.props;

function toHex(hex: string): string {
  const cleaned = String(hex ?? '').trim().replace(/^#/, '');
  return cleaned ? `#${cleaned}` : '#888888';
}

const normalizedGroups = colorGroups.map((g) => ({
  ...g,
  colors: g.colors.map((c) => ({ ...c, hex: toHex(c.hex) })),
}));
const groupsJson = JSON.stringify(normalizedGroups);
---

<div class="color-picker-root flex flex-col gap-6" data-groups={groupsJson}>

  {normalizedGroups.map((group, gi) => (
    <div>
      <div class="mb-2 flex items-center gap-2">
        <span class="text-sm font-bold text-white">{group.label}</span>
        <span
          class="selected-label rounded-full bg-[#c9a448]/15 px-2.5 py-0.5 text-xs font-semibold text-[#c9a448]"
          data-group={gi}
        >
          — pilih warna
        </span>
      </div>

      <div class="flex flex-wrap gap-2" role="radiogroup" aria-label={group.label}>
        {group.colors.map((color, ci) => (
          <button
            type="button"
            role="radio"
            aria-checked="false"
            aria-label={color.name}
            data-group={gi}
            data-index={ci}
            data-name={color.name}
            data-hex={color.hex}
            data-img-index={color.imageIndex ?? ''}
            class:list={[
              'color-swatch',
              'relative size-8 border-2 border-white/20 outline outline-2 outline-transparent',
              'transition-all duration-150 hover:scale-110 hover:outline-[#c9a448]',
              'focus:outline-[#c9a448] focus:scale-110',
              group.type === 'accent' ? 'rounded-lg' : 'rounded-full',
            ]}
            style={`background-color: ${color.hex}; box-shadow: inset 0 0 0 1px rgba(255,255,255,.08);`}
            title={color.name}
          >
            <svg
              class="check-icon pointer-events-none absolute inset-0 m-auto hidden size-4 drop-shadow"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
            >
              <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
            </svg>
          </button>
        ))}
      </div>
    </div>
  ))}

  <!-- Ringkasan pilihan -->
  <div id="color-summary" class="hidden rounded-2xl border border-[#c9a448]/20 bg-[#c9a448]/8 p-4">
    <div class="text-xs font-bold uppercase tracking-wider text-[#c9a448]">Pilihan Anda</div>
    <ul id="summary-list" class="mt-2 space-y-1 text-sm text-white/80"></ul>
    <p class="mt-3 text-xs text-white/40">
      Pilihan warna akan dikirimkan otomatis saat Anda klik tombol WhatsApp di bawah.
    </p>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('.color-picker-root');
  if (!root) throw new Error('ColorPicker root not found');

  const groups: Array<{ label: string; type: string; colors: Array<{ name: string; hex: string }> }> =
    JSON.parse(root.dataset.groups ?? '[]');

  const selectedColors: Array<{ name: string; hex: string } | null> = groups.map(() => null);

  function normalizeHex(hex: string): string {
    const cleaned = String(hex ?? '').trim().replace(/^#/, '');
    return cleaned ? `#${cleaned}` : '#888888';
  }

  function getLuminance(hex: string): number {
    const h = normalizeHex(hex);
    const r = parseInt(h.slice(1, 3), 16);
    const g = parseInt(h.slice(3, 5), 16);
    const b = parseInt(h.slice(5, 7), 16);
    return 0.299 * r + 0.587 * g + 0.114 * b;
  }

  function updateSummary(): void {
    const summary   = document.getElementById('color-summary');
    const list      = document.getElementById('summary-list');
    const waButtons = document.querySelectorAll<HTMLAnchorElement>('[data-wa-base]');
    if (!summary || !list) return;

    const chosen = selectedColors.filter(Boolean);
    if (chosen.length === 0) { summary.classList.add('hidden'); return; }

    summary.classList.remove('hidden');
    list.innerHTML = selectedColors
      .map((sel, gi) =>
        sel
          ? `<li class="flex items-center gap-2">
               <span class="inline-block size-4 rounded-full border border-white/20 shrink-0" style="background:${sel.hex}"></span>
               <span class="font-semibold text-[#c9a448]">${groups[gi].label}:</span> ${sel.name}
             </li>`
          : '',
      )
      .join('');

    const colorInfo = selectedColors
      .map((sel, gi) => (sel ? `${groups[gi].label}: ${sel.name}` : null))
      .filter(Boolean)
      .join(', ');

    waButtons.forEach((btn) => {
      const base = btn.dataset.waBase ?? '';
      btn.href = base + encodeURIComponent(`\n\nPilihan warna: ${colorInfo}`);
    });
  }

  function updateMainImage(imgIndex: string): void {
    if (!imgIndex) return;
    const idx     = parseInt(imgIndex, 10);
    const mainImg = document.getElementById('main-img') as HTMLImageElement | null;
    const thumbs  = document.querySelectorAll<HTMLButtonElement>('.thumb-btn');
    if (mainImg && thumbs[idx]) {
      const src = thumbs[idx].dataset.src ?? '';
      if (src) {
        mainImg.src = src;
        thumbs.forEach((b) => b.classList.remove('border-[#c9a448]'));
        thumbs[idx].classList.add('border-[#c9a448]');
      }
    }
  }

  root.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.color-swatch');
    if (!btn) return;

    const gi       = parseInt(btn.dataset.group ?? '0', 10);
    const name     = btn.dataset.name ?? '';
    const hex      = normalizeHex(btn.dataset.hex ?? '#000');
    const imgIndex = btn.dataset.imgIndex ?? '';

    root.querySelectorAll<HTMLButtonElement>(`.color-swatch[data-group="${gi}"]`)
      .forEach((b) => {
        b.setAttribute('aria-checked', 'false');
        b.style.outlineColor = 'transparent';
        b.querySelector<SVGElement>('.check-icon')?.classList.add('hidden');
      });

    btn.setAttribute('aria-checked', 'true');
    btn.style.outlineColor = '#c9a448';

    const check = btn.querySelector<SVGElement>('.check-icon');
    if (check) {
      check.classList.remove('hidden');
      check.style.color = getLuminance(hex) > 160 ? '#1a1a1a' : '#ffffff';
    }

    const label = root.querySelector<HTMLElement>(`.selected-label[data-group="${gi}"]`);
    if (label) label.textContent = name;

    selectedColors[gi] = { name, hex };
    updateMainImage(imgIndex);
    updateSummary();
  });
</script>
