---
import type { Product } from '../types/product';
import { buildWaMessage } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const { slug, name, category, shortDesc, images, badge, inStock } = product;

const WA_NUMBER = '6285282400061';
const waMsg     = buildWaMessage(product);
const waUrl     = `https://wa.me/${WA_NUMBER}?text=${waMsg}`;

const badgeClass: Record<string, string> = {
  'TERLARIS': 'badge-gold',
  'BARU':     'badge-green',
  'PROMO':    'badge-red',
};
const bClass = badge ? (badgeClass[badge] ?? 'badge-gold') : '';
---

<article class="card-lift group flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-[#111111] shadow-sm">

  <!-- Gambar -->
  <a href={`/produk/${slug}`} class="img-zoom group/img relative block aspect-[4/3] bg-[#1a1a1a]" aria-label={`Lihat detail ${name}`}>
    {images[0] ? (
      <img
        src={images[0]}
        alt={name}
        class="h-full w-full object-cover"
        loading="lazy"
        decoding="async"
        width="400"
        height="300"
      />
    ) : (
      <div class="flex h-full items-center justify-center text-4xl text-white/20">🧳</div>
    )}

    <!-- Hover overlay -->
    <div class="card-img-overlay">
      <span class="rounded-full bg-[#c9a448] px-3 py-1 text-xs font-bold text-black">Lihat Detail →</span>
    </div>

    {badge && (
      <div class="absolute left-3 top-3">
        <span class={`badge ${bClass}`}>{badge}</span>
      </div>
    )}

    {!inStock && (
      <div class="absolute inset-0 flex items-center justify-center bg-black/60">
        <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-bold text-white/80 backdrop-blur">Stok Habis</span>
      </div>
    )}
  </a>

  <!-- Konten -->
  <div class="flex flex-1 flex-col gap-3 p-4">
    <div>
      <div class="text-[11px] font-semibold uppercase tracking-widest text-[#c9a448]">{category.replace('-', ' ')}</div>
      <h3 class="mt-1 text-base font-bold leading-snug text-white">
        <a href={`/produk/${slug}`} class="hover:text-[#c9a448] transition-colors">{name}</a>
      </h3>
      <p class="mt-1.5 line-clamp-2 text-sm leading-6 text-white/50">{shortDesc}</p>
    </div>

    <!-- CTA -->
    <div class="mt-auto flex items-center justify-between gap-3 pt-1">
      {inStock ? (
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-wa w-full justify-center px-4 py-2 text-xs"
          aria-label={`Tanya harga ${name} via WhatsApp`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-3.5" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Tanya Harga
        </a>
      ) : (
        <span class="w-full text-center text-xs font-semibold text-white/30">Stok Habis</span>
      )}
    </div>
  </div>
</article>
