---
import type { Product } from '../types/product';
import { CATEGORY_LABELS } from '../types/product';
import { buildWaUrl } from '../data/products';
import { responsiveImage } from '../lib/media';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const { slug, name, category, shortDesc, images, badge, inStock } = product;
const categoryLabel = CATEGORY_LABELS[category] ?? category;
const waUrl = buildWaUrl(product);
const thumb = images[0] ? responsiveImage(images[0], '(max-width: 640px) 50vw, 400px') : null;
---

<article class="group flex flex-col border border-[#e8e8e8] bg-white transition-[border-color,box-shadow] hover:border-[#c9a448] hover:shadow-[0_16px_32px_rgba(17,17,17,0.06)]">
  <a href={`/produk/${slug}`} class="relative block aspect-[4/3] overflow-hidden border-b border-[#e8e8e8] bg-white" aria-label={`Lihat ${name}`}>
    {thumb ? (
      <img
        src={thumb.src}
        srcset={thumb.srcset}
        sizes={thumb.sizes}
        alt={name}
        class="h-full w-full bg-white object-cover object-center"
        loading="lazy"
        decoding="async"
        width="400"
        height="300"
      />
    ) : (
      <div class="flex h-full items-center justify-center text-4xl text-[#c9a448]/40">🧳</div>
    )}
    {badge && (
      <div class="absolute left-3 top-3">
        <span class="badge">{badge}</span>
      </div>
    )}
    {!inStock && (
      <div class="absolute inset-0 flex items-center justify-center bg-white/70">
        <span class="border border-[#161412]/20 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-[#161412]">Stok Habis</span>
      </div>
    )}
  </a>

  <div class="flex flex-1 flex-col p-4">
    <div class="text-[10px] font-bold uppercase tracking-[.16em] text-[#c9a448]">{categoryLabel}</div>
    <h3 class="mt-1.5 font-display text-xl font-semibold leading-snug text-[#161412]">
      <a href={`/produk/${slug}`} class="transition-colors hover:text-[#c9a448]" aria-label={`Detail produk ${name}`}>{name}</a>
    </h3>
    <p class="mt-1.5 line-clamp-2 text-xs leading-5 text-[#5c5854]">{shortDesc}</p>
    <div class="mt-auto pt-4">
      {inStock ? (
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex w-full items-center justify-center border border-[#c9a448]/45 px-3 py-2.5 text-[0.72rem] font-bold uppercase tracking-[0.12em] text-[#c9a448] no-underline transition-colors hover:bg-[#c9a448] hover:text-[#111]"
          aria-label={`Tanya harga ${name}`}
        >
          Tanya Harga
        </a>
      ) : (
        <div class="py-2 text-center text-xs font-semibold text-[#9a9084]">Stok Habis</div>
      )}
    </div>
  </div>
</article>
