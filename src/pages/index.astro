---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import BundleCard from '../components/BundleCard.astro';
import { getFeaturedProducts, getBundleProducts } from '../data/products';
import { getHero, siteWaLink } from '../data/hero';
import { getTentang } from '../data/tentang';
import { getMitra } from '../data/mitra';
import { getKatalogDownload } from '../data/katalog';
import { getPromo } from '../data/promo';
import { CATALOG_CATEGORIES } from '../types/product';
import { responsiveImage } from '../lib/media';

// Bake HTML at build (CF Worker cannot read content/*.yaml via fs at runtime)
export const prerender = true;

const featured = getFeaturedProducts(4);
const bundles  = getBundleProducts();
const hero = getHero();
const tentang = getTentang();
const mitra = getMitra();
const katalogDl = getKatalogDownload();
const promo = getPromo();
const promoCards = promo.cards.map((card) => ({
  ...card,
  img: responsiveImage(card.image, '(max-width: 768px) 100vw, 50vw'),
}));
const ctaWaUrl = siteWaLink(hero.waMessage);
const mitraRowA = mitra.partners.filter((_, i) => i % 2 === 0);
const mitraRowB = mitra.partners.filter((_, i) => i % 2 === 1);
const heroSlides = hero.slides.map((slide) => ({
  ...slide,
  img: responsiveImage(slide.src, '(max-width: 1023px) 100vw, 520px'),
}));

/** Line-icon SVG paths per kategori (lebih rapi dari emoji) */
const categoryIcons: Record<string, string[]> = {
  'koper-premium-polypropylane': [
    'M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2',
    'M6 7h12a1 1 0 0 1 1 1v11a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V8a1 1 0 0 1 1-1z',
    'M12 6v2',
    'M9.5 14.5l1.8 1.8 3.2-3.5',
  ],
  'koper-standar': [
    'M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2',
    'M6 7h12a1 1 0 0 1 1 1v11a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V8a1 1 0 0 1 1-1z',
    'M12 6v2',
    'M9 13h6',
    'M9 16h4',
  ],
  'koper-polycarbonate-premium': [
    'M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2',
    'M6 7h12a1 1 0 0 1 1 1v11a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V8a1 1 0 0 1 1-1z',
    'M12 6v2',
    'M16.5 11.2l.9-2 .9 2 2 .4-1.6 1.3.5 2.1-1.8-1.1-1.8 1.1.5-2.1-1.6-1.3z',
  ],
  'koper-embos-moulding': [
    'M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2',
    'M6 7h12a1 1 0 0 1 1 1v11a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V8a1 1 0 0 1 1-1z',
    'M12 6v2',
    'M9 12h2v2H9z',
    'M13 12h2v2h-2z',
    'M9 16h2v2H9z',
    'M13 16h2v2h-2z',
  ],
};

const categories = CATALOG_CATEGORIES.map((c) => ({
  ...c,
  iconPaths: categoryIcons[c.value] ?? ['M12 6v12'],
  slug: c.value,
}));
---

<Layout
  title="Supplier Koper Umroh Haji"
  description="Supplier koper umroh & haji dan pabrik koper Jakarta Barat. Custom logo dan warna travel, bahan PP PC ABS anti pecah. Harga pabrik"
>
  <!-- ── HERO ─────────────────────────────────────────────────── -->
  <section class="hero-pattern" aria-labelledby="hero-heading">
    <!-- Mobile: carousel hero (desktop tetap collage) -->
    <div class="animate-fade-up relative lg:hidden" id="hero-carousel" aria-roledescription="carousel" aria-label="Foto produk unggulan">
      <div class="relative aspect-[16/10] w-full overflow-hidden">
        <div class="hero-track flex h-full transition-transform duration-500 ease-out" style="transform: translateX(0%);">
          {heroSlides.map((slide, i) => (
            <div class="h-full w-full shrink-0" role="group" aria-roledescription="slide" aria-label={`${i + 1} dari ${heroSlides.length}`}>
              <img
                src={slide.img.src}
                srcset={slide.img.srcset}
                sizes={slide.img.sizes}
                alt={slide.alt}
                class="h-full w-full object-cover object-center"
                width="800"
                height="500"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
              />
            </div>
          ))}
        </div>
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#0d0d0d] via-[#0d0d0d]/25 to-transparent"></div>
      </div>
    </div>

    <!-- Hero desktop: teks + collage muat 1 viewport (tanpa margin acak) -->
    <div class="container-page grid items-center gap-8 py-8 lg:min-h-[calc(100svh-4rem)] lg:grid-cols-[1.1fr_.9fr] lg:gap-10 lg:py-6">

      <div>
        <div class="animate-fade-up mb-4 inline-flex items-center gap-2 rounded-full border border-[#c9a448]/40 bg-[#c9a448]/10 px-4 py-1.5 text-xs font-bold text-[#c9a448]">
          {hero.eyebrow}
        </div>

        <h1 id="hero-heading" class="animate-fade-up animate-fade-up-d1 max-w-2xl text-4xl leading-[1.12] text-white sm:text-5xl lg:text-[2.75rem] xl:text-6xl">
          {hero.headline}<br />
          <span class="text-[#c9a448]">{hero.headlineAccent.trim()}</span>
        </h1>

        <div class="animate-fade-up animate-fade-up-d2 font-body mt-4 max-w-lg space-y-2 text-sm leading-6 text-white/70">
          {hero.paragraphs.map((p) => (
            <p>{p}</p>
          ))}
        </div>

        <div class="animate-fade-up animate-fade-up-d3 mt-6 flex flex-wrap gap-3">
          <a href={hero.primaryCtaHref} class="btn-primary">
            {hero.primaryCtaLabel}
          </a>
          <a
            href={hero.secondaryCtaHref}
            class="btn-outline"
            target={hero.secondaryCtaHref.startsWith('http') ? '_blank' : undefined}
            rel={hero.secondaryCtaHref.startsWith('http') ? 'noopener noreferrer' : undefined}
          >
            {hero.secondaryCtaLabel}
          </a>
        </div>

        <div class="animate-fade-up animate-fade-up-d4 mt-5 flex flex-wrap gap-x-6 gap-y-2">
          {hero.trustItems.map((item) => (
            <div class="flex items-center gap-1.5 text-xs text-white/60">
              <span class="text-[#c9a448]">✓</span> {item}
            </div>
          ))}
        </div>
      </div>

      {heroSlides.length > 0 && (
        <div class="hero-collage animate-fade-up animate-fade-up-d2 relative hidden lg:block">
          <div class="pointer-events-none absolute -inset-6 rounded-[2.5rem] bg-[#c9a448]/12 blur-3xl" aria-hidden="true"></div>
          <div class="hero-collage__grid relative">
            <div class="hero-collage__stack">
              {heroSlides.slice(1, 3).map((slide) => (
                <figure class="hero-collage__shot hero-collage__side m-0 overflow-hidden rounded-2xl bg-[#111]">
                  <img
                    src={slide.img.src}
                    srcset={slide.img.srcset}
                    sizes="360px"
                    alt={slide.alt}
                    width="360"
                    height="480"
                    loading="eager"
                  />
                </figure>
              ))}
            </div>
            <!-- Hero 1 di depan, overlap stack kanan — object-position agar teks bawah tidak kepotong -->
            <figure class="hero-collage__shot hero-collage__main m-0 overflow-hidden rounded-2xl bg-[#111]">
              <img
                src={heroSlides[0].img.src}
                srcset={heroSlides[0].img.srcset}
                sizes="520px"
                alt={heroSlides[0].alt}
                width="520"
                height="693"
                loading="eager"
              />
            </figure>
          </div>
        </div>
      )}
    </div>
  </section>

  <style>
    .hero-collage__grid {
      --collage-h: min(34rem, calc(100svh - 7.25rem));
      position: relative;
      height: var(--collage-h);
      overflow: visible;
    }
    /* Stack 2–3: box lebih tinggi ke bawah agar "Komplit 4 in 1" tidak kepotong */
    .hero-collage__stack {
      position: absolute;
      top: 0;
      right: 0;
      bottom: -0.75rem;
      width: 68%;
      display: grid;
      grid-template-rows: 1fr 1fr;
      gap: 0.65rem;
      z-index: 1;
    }
    .hero-collage__side {
      position: relative;
      min-height: 0;
      height: 100%;
      background: #111;
    }
    /* Hero 1: sedikit lebih lebar ke kiri */
    .hero-collage__main {
      position: absolute;
      left: -0.75rem;
      top: 10%;
      bottom: 14%;
      width: calc(54% + 1.25rem);
      z-index: 2;
      background: #111;
      box-shadow:
        0 22px 50px rgba(0, 0, 0, 0.5),
        0 0 0 1px rgba(201, 164, 72, 0.12);
    }
    .hero-collage__shot {
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.4);
    }
    .hero-collage__shot > img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }
    .hero-collage__main > img {
      object-position: 70% center;
    }
    .hero-collage__side > img {
      object-position: 78% 88%;
    }
    .hero-collage__main:hover > img,
    .hero-collage__side:hover > img {
      transform: scale(1.02);
    }
  </style>

  <script>
    function initHeroCarousel() {
      const root = document.getElementById('hero-carousel');
      if (!root || window.matchMedia('(min-width: 1024px)').matches) return;

      const track = root.querySelector<HTMLElement>('.hero-track');
      if (!track) return;

      const total = track.children.length;
      if (total < 2) return;

      let index = 0;
      let timer: ReturnType<typeof setInterval> | undefined;
      let startX = 0;
      let deltaX = 0;
      let dragging = false;

      const goTo = (next: number) => {
        index = ((next % total) + total) % total;
        track.style.transform = `translateX(-${index * 100}%)`;
      };

      const startAuto = () => {
        stopAuto();
        timer = setInterval(() => goTo(index + 1), 4000);
      };

      const stopAuto = () => {
        if (timer) clearInterval(timer);
        timer = undefined;
      };

      root.addEventListener('pointerdown', (e) => {
        dragging = true;
        startX = e.clientX;
        deltaX = 0;
        stopAuto();
        root.setPointerCapture(e.pointerId);
      });

      root.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        deltaX = e.clientX - startX;
      });

      root.addEventListener('pointerup', () => {
        if (!dragging) return;
        dragging = false;
        if (Math.abs(deltaX) > 40) goTo(index + (deltaX < 0 ? 1 : -1));
        startAuto();
      });

      root.addEventListener('pointercancel', () => {
        dragging = false;
        startAuto();
      });

      goTo(0);
      startAuto();
    }

    initHeroCarousel();
    document.addEventListener('astro:page-load', initHeroCarousel);
  </script>

  <!-- ── KATEGORI ───────────────────────────────────────────── -->
  <section class="bg-[#111111] py-14" aria-labelledby="kategori-heading">
    <div class="container-page">
      <div class="gold-line mx-auto"></div>
      <h2 id="kategori-heading" class="mt-4 text-center text-2xl text-white/80 md:text-3xl">Belanja Berdasarkan Kategori</h2>
      <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
        {categories.map(({ iconPaths, label, slug }) => (
          <a
            href={`/katalog?kategori=${slug}`}
            aria-label={`Lihat katalog kategori ${label}`}
            class="group flex flex-col items-center gap-3 rounded-xl border border-white/8 bg-[#161616] px-2 py-4 text-center transition-all duration-200 hover:border-[#c9a448]/40 hover:bg-[#c9a448]/6"
          >
            <div class="flex size-11 items-center justify-center rounded-xl border border-[#c9a448]/25 bg-[#c9a448]/10 text-[#c9a448] transition-all group-hover:border-[#c9a448]/55 group-hover:bg-[#c9a448]/18">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.55"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-5"
                aria-hidden="true"
              >
                {iconPaths.map((d) => <path d={d} />)}
              </svg>
            </div>
            <span class="font-body text-[10px] font-semibold leading-tight text-white/50 transition-colors group-hover:text-white/80">{label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── BANNER / CTA PROMO ─────────────────────────────────── -->
  <section class="bg-[#0d0d0d] py-16" aria-labelledby="banner-heading">
    <div class="container-page">
      <div class="gold-line"></div>
      <h2 id="banner-heading" class="mt-4 text-3xl text-white md:text-4xl">{promo.heading}</h2>
      <p class="mt-2 max-w-xl text-white/50">{promo.description}</p>

      <div
        class:list={[
          'mt-8 grid gap-4',
          promoCards.length === 1
            ? 'grid-cols-1'
            : promoCards.length === 2
              ? 'lg:grid-cols-[1.6fr_1fr]'
              : 'sm:grid-cols-2',
        ]}
      >
        {promoCards.map((card, i) => (
          <a
            href={card.href}
            class="card-lift img-zoom group relative block overflow-hidden rounded-3xl bg-[#1a1a1a]"
          >
            <img
              src={card.img.src}
              srcset={card.img.srcset}
              sizes={card.img.sizes}
              alt={card.alt}
              class:list={[
                'h-full min-h-64 w-full object-cover lg:min-h-80',
                i === 1 && promoCards.length === 2 ? 'object-top' : '',
              ]}
              loading="lazy"
              decoding="async"
              width={i === 0 && promoCards.length === 2 ? 800 : 600}
              height="500"
            />
            <div
              class:list={[
                'absolute inset-0',
                i === 0 && promoCards.length <= 2
                  ? 'bg-gradient-to-t from-black/60 via-black/10 to-transparent'
                  : 'bg-gradient-to-t from-black/70 via-transparent to-transparent',
              ]}
            ></div>
            <div class="absolute bottom-5 left-5 right-5">
              <div class="text-xs font-bold uppercase tracking-widest text-[#c9a448]">{card.eyebrow}</div>
              <div class="mt-1 font-display text-xl text-white md:text-2xl">{card.title}</div>
              <div class="mt-1 text-sm text-white/75">{card.subtitle}</div>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-5 flex flex-wrap gap-3">
        <a href={promo.primaryCtaHref} class="btn-primary">{promo.primaryCtaLabel}</a>
        <a href={promo.secondaryCtaHref} class="btn-outline">{promo.secondaryCtaLabel}</a>
      </div>
    </div>
  </section>

  <!-- ── PRODUK UNGGULAN ───────────────────────────────────── -->
  <section class="bg-[#0d0d0d] py-16" aria-labelledby="featured-heading">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <div class="gold-line"></div>
          <h2 id="featured-heading" class="mt-4 text-3xl text-white md:text-4xl">Produk Unggulan</h2>
          <p class="mt-2 text-white/50">Pilihan yang paling banyak diminati jamaah.</p>
        </div>
        <a href="/katalog" class="btn-outline">Lihat Semua →</a>
      </div>

      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {featured.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    </div>
  </section>

  <!-- ── BUNDLING ───────────────────────────────────────────── -->
  <section id="bundling" class="bg-[#111111] py-16" aria-labelledby="bundling-heading">
    <div class="container-page">
      <div class="gold-line"></div>
      <h2 id="bundling-heading" class="mt-4 text-3xl text-white md:text-4xl">Paket Bundling</h2>
      <p class="mt-2 text-white/50">Hemat lebih besar dengan paket lengkap sekaligus.</p>

      <div class="mt-8 flex flex-col gap-6">
        {bundles.map((product) => (
          <BundleCard product={product} />
        ))}
      </div>
    </div>
  </section>

  <!-- ── KENAPA Berkah Koper ──────────────────────────────────── -->
  <section id="tentang" class="bg-[#0d0d0d] py-16" aria-labelledby="whyus-heading">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-[.9fr_1.1fr] lg:gap-12">
        <div>
          <div class="gold-line"></div>
          <h2 id="whyus-heading" class="mt-4 text-3xl text-white md:text-4xl">{tentang.heading}</h2>
          <p class="mt-4 leading-7 text-white/50">
            {tentang.description}
          </p>
        </div>
        <!-- mt sejajar judul kiri (bukan gold-line) agar card tidak nempel sticky header -->
        <div class="grid gap-4 sm:grid-cols-2 lg:mt-7">
          {tentang.items.map(({ icon, title, desc }) => (
            <div class="group rounded-xl border border-white/8 bg-[#161616] p-5 transition-all hover:border-[#c9a448]/25 hover:bg-[#c9a448]/4">
              <div class="mb-4 flex size-9 items-center justify-center rounded-lg border border-[#c9a448]/20 bg-[#c9a448]/8 text-base">
                {icon}
              </div>
              <h3 class="font-body text-sm font-bold text-white/90">{title}</h3>
              <p class="mt-1.5 text-xs leading-5 text-white/45">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── MITRA TOUR / CLIENT ─────────────────────────────────── -->
  {mitra.partners.length > 0 && (
    <section
      id="mitra"
      class="mitra-section overflow-hidden py-16"
      aria-labelledby="mitra-heading"
    >
      <div class="container-page">
        <div class="gold-line"></div>
        <h2 id="mitra-heading" class="mt-4 text-3xl text-white md:text-4xl">
          {mitra.heading}
        </h2>
        <p class="mt-2 max-w-xl text-white/50">
          {mitra.description}
        </p>
        <p class="mt-3 text-sm font-semibold text-white/35">
          {mitra.partners.length}+ biro & travel partner
        </p>

        <div class="mitra-marquee mt-8" aria-label="Logo mitra travel">
          <div class="mitra-track" style={`--mitra-duration: ${Math.max(40, mitraRowA.length * 3)}s`}>
            {[...mitraRowA, ...mitraRowA].map((partner) => (
              <div class="mitra-logo" title={partner.name}>
                <img
                  src={partner.src}
                  alt={partner.name}
                  loading="lazy"
                  decoding="async"
                  width="220"
                  height="110"
                />
              </div>
            ))}
          </div>
          {mitraRowB.length > 0 && (
            <div
              class="mitra-track mitra-track--reverse mt-4"
              style={`--mitra-duration: ${Math.max(45, mitraRowB.length * 3.2)}s`}
            >
              {[...mitraRowB, ...mitraRowB].map((partner) => (
                <div class="mitra-logo" title={partner.name}>
                  <img
                    src={partner.src}
                    alt={partner.name}
                    loading="lazy"
                    decoding="async"
                    width="220"
                    height="110"
                  />
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- ── CTA BANNER ────────────────────────────────────────── -->
  <section class="py-16" style="background:linear-gradient(135deg,#1a1400 0%,#0d0d0d 100%);border-top:1px solid rgba(201,164,72,.2);border-bottom:1px solid rgba(201,164,72,.2)" aria-label="Hubungi kami">
    <div class="container-page flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
      <div>
        <div class="text-sm font-bold uppercase tracking-widest text-[#c9a448]">{katalogDl.eyebrow}</div>
        <h2 class="mt-2 max-w-xl text-3xl text-white md:text-4xl">{katalogDl.heading}</h2>
      </div>
      <div class="flex shrink-0 flex-wrap gap-3">
        {katalogDl.fileUrl ? (
          <a
            href={katalogDl.fileUrl}
            class="btn-outline-gold"
            download={katalogDl.fileUrl.startsWith('http') ? undefined : katalogDl.fileName}
            target={katalogDl.fileUrl.startsWith('http') ? '_blank' : undefined}
            rel={katalogDl.fileUrl.startsWith('http') ? 'noopener noreferrer' : undefined}
          >
            {katalogDl.buttonLabel}
          </a>
        ) : (
          <a href="/katalog" class="btn-outline-gold">
            Lihat Katalog
          </a>
        )}
        <a
          href={ctaWaUrl}
          class="btn-primary"
          target="_blank"
          rel="noopener noreferrer"
        >
          Chat WhatsApp →
        </a>
      </div>
    </div>
  </section>
</Layout>
