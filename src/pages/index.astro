---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import BundleCard from '../components/BundleCard.astro';
import { getFeaturedProducts, getBundleProducts } from '../data/products';
import { getHero } from '../data/hero';
import { getTentang } from '../data/tentang';
import { getMitra } from '../data/mitra';
import { buildWaLink } from '../lib/media';
import { CATALOG_CATEGORIES } from '../types/product';

// Bake HTML at build (CF Worker cannot read content/*.yaml via fs at runtime)
export const prerender = true;

const featured = getFeaturedProducts(4);
const bundles  = getBundleProducts();
const hero = getHero();
const tentang = getTentang();
const mitra = getMitra();
const mitraRowA = mitra.partners.filter((_, i) => i % 2 === 0);
const mitraRowB = mitra.partners.filter((_, i) => i % 2 === 1);
const heroSlides = hero.slides;

const categoryIcons: Record<string, string> = {
  koper: '🧳',
  'tas-kabin': '🎒',
  'tas-paspor-selempang': '👜',
  'tas-sandal': '👟',
};

const categories = CATALOG_CATEGORIES.map((c) => ({
  ...c,
  icon: categoryIcons[c.value] ?? '•',
  slug: c.value,
}));
---

<Layout>
  <!-- ── HERO ─────────────────────────────────────────────────── -->
  <section class="hero-pattern overflow-hidden" aria-labelledby="hero-heading">
    <!-- Mobile: carousel hero (desktop tetap collage) -->
    <div class="animate-fade-up relative lg:hidden" id="hero-carousel" aria-roledescription="carousel" aria-label="Foto produk unggulan">
      <div class="relative aspect-[16/10] w-full overflow-hidden">
        <div class="hero-track flex h-full transition-transform duration-500 ease-out" style="transform: translateX(0%);">
          {heroSlides.map((slide, i) => (
            <div class="h-full w-full shrink-0" role="group" aria-roledescription="slide" aria-label={`${i + 1} dari ${heroSlides.length}`}>
              <img
                src={slide.src}
                alt={slide.alt}
                class="h-full w-full object-cover object-center"
                width="800"
                height="500"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
              />
            </div>
          ))}
        </div>
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#0d0d0d] via-[#0d0d0d]/25 to-transparent"></div>
      </div>

      <div class="absolute bottom-3 left-0 right-0 z-10 flex items-center justify-center gap-2">
        {heroSlides.map((_, i) => (
          <button
            type="button"
            class="hero-dot size-2 rounded-full transition-all"
            data-index={i}
            aria-label={`Slide ${i + 1}`}
            aria-current={i === 0 ? 'true' : 'false'}
          ></button>
        ))}
      </div>
    </div>

    <div class="container-page grid items-center gap-10 py-10 lg:min-h-[600px] lg:grid-cols-[1.1fr_.9fr] lg:gap-12 lg:py-12">

      <div>
        <div class="animate-fade-up mb-5 inline-flex items-center gap-2 rounded-full border border-[#c9a448]/40 bg-[#c9a448]/10 px-4 py-1.5 text-xs font-bold text-[#c9a448]">
          {hero.eyebrow}
        </div>

        <h1 id="hero-heading" class="animate-fade-up animate-fade-up-d1 max-w-2xl text-4xl leading-[1.12] text-white sm:text-5xl md:text-6xl">
          {hero.headline}<br />
          <span class="text-[#c9a448]">{hero.headlineAccent.trim()}</span>
        </h1>

        <div class="animate-fade-up animate-fade-up-d2 font-body mt-5 max-w-lg space-y-2.5 text-sm leading-7 text-white/70">
          {hero.paragraphs.map((p) => (
            <p>{p}</p>
          ))}
        </div>

        <div class="animate-fade-up animate-fade-up-d3 mt-8 flex flex-wrap gap-3">
          <a href={hero.primaryCtaHref} class="btn-primary">
            {hero.primaryCtaLabel}
          </a>
          <a
            href={hero.secondaryCtaHref}
            class="btn-outline"
            target={hero.secondaryCtaHref.startsWith('http') ? '_blank' : undefined}
            rel={hero.secondaryCtaHref.startsWith('http') ? 'noopener noreferrer' : undefined}
          >
            {hero.secondaryCtaLabel}
          </a>
        </div>

        <div class="animate-fade-up animate-fade-up-d4 mt-8 flex flex-wrap gap-x-6 gap-y-2">
          {hero.trustItems.map((item) => (
            <div class="flex items-center gap-1.5 text-xs text-white/60">
              <span class="text-[#c9a448]">✓</span> {item}
            </div>
          ))}
        </div>
      </div>

      <!-- Desktop: collage editorial 1 besar + 2 bertingkat (profesional, tanpa garis/ring) -->
      {heroSlides.length > 0 && (
        <div class="hero-collage animate-fade-up animate-fade-up-d2 relative hidden lg:block">
          <div class="pointer-events-none absolute -inset-6 rounded-[2.5rem] bg-[#c9a448]/12 blur-3xl" aria-hidden="true"></div>
          <div class="relative grid grid-cols-2 items-start gap-3">
            <figure class="hero-collage__shot hero-collage__shot--main m-0 overflow-hidden rounded-2xl bg-[#111]">
              <img
                src={heroSlides[0].src}
                alt={heroSlides[0].alt}
                class="aspect-[3/4] h-full w-full object-cover object-center"
                width="520"
                height="693"
                loading="eager"
              />
            </figure>
            <div class="flex flex-col gap-3 pt-10">
              {heroSlides.slice(1, 3).map((slide) => (
                <figure class="hero-collage__shot m-0 overflow-hidden rounded-2xl bg-[#111]">
                  <img
                    src={slide.src}
                    alt={slide.alt}
                    class="aspect-[3/4] h-full w-full object-cover object-center"
                    width="360"
                    height="480"
                    loading="eager"
                  />
                </figure>
              ))}
            </div>
          </div>
        </div>
      )}
    </div>
  </section>

  <style>
    .hero-dot {
      background: rgba(255, 255, 255, 0.35);
    }
    .hero-dot[aria-current='true'] {
      width: 1.25rem;
      background: #c9a448;
    }
    .hero-collage__shot {
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
    }
    .hero-collage__shot img {
      transition: transform 0.5s ease;
    }
    .hero-collage__shot:hover img {
      transform: scale(1.03);
    }
  </style>

  <script>
    function initHeroCarousel() {
      const root = document.getElementById('hero-carousel');
      if (!root || window.matchMedia('(min-width: 1024px)').matches) return;

      const track = root.querySelector<HTMLElement>('.hero-track');
      const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.hero-dot'));
      if (!track || dots.length === 0) return;

      const total = dots.length;
      let index = 0;
      let timer: ReturnType<typeof setInterval> | undefined;
      let startX = 0;
      let deltaX = 0;
      let dragging = false;

      const goTo = (next: number) => {
        index = ((next % total) + total) % total;
        track.style.transform = `translateX(-${index * 100}%)`;
        dots.forEach((dot, i) => {
          dot.setAttribute('aria-current', i === index ? 'true' : 'false');
        });
      };

      const startAuto = () => {
        stopAuto();
        timer = setInterval(() => goTo(index + 1), 4000);
      };

      const stopAuto = () => {
        if (timer) clearInterval(timer);
        timer = undefined;
      };

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          goTo(Number(dot.dataset.index ?? 0));
          startAuto();
        });
      });

      root.addEventListener('pointerdown', (e) => {
        dragging = true;
        startX = e.clientX;
        deltaX = 0;
        stopAuto();
        root.setPointerCapture(e.pointerId);
      });

      root.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        deltaX = e.clientX - startX;
      });

      root.addEventListener('pointerup', () => {
        if (!dragging) return;
        dragging = false;
        if (Math.abs(deltaX) > 40) goTo(index + (deltaX < 0 ? 1 : -1));
        startAuto();
      });

      root.addEventListener('pointercancel', () => {
        dragging = false;
        startAuto();
      });

      goTo(0);
      startAuto();
    }

    initHeroCarousel();
    document.addEventListener('astro:page-load', initHeroCarousel);
  </script>

  <!-- ── KATEGORI ───────────────────────────────────────────── -->
  <section class="bg-[#111111] py-14" aria-labelledby="kategori-heading">
    <div class="container-page">
      <div class="gold-line mx-auto"></div>
      <h2 id="kategori-heading" class="mt-4 text-center text-2xl text-white/80 md:text-3xl">Belanja Berdasarkan Kategori</h2>
      <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
        {categories.map(({ icon, label, slug }) => (
          <a
            href={`/katalog?kategori=${slug}`}
            class="group flex flex-col items-center gap-3 rounded-xl border border-white/8 bg-[#161616] px-2 py-4 text-center transition-all duration-200 hover:border-[#c9a448]/40 hover:bg-[#c9a448]/6"
          >
            <div class="flex size-10 items-center justify-center rounded-xl border border-[#c9a448]/20 bg-[#c9a448]/8 text-lg transition-all group-hover:border-[#c9a448]/50 group-hover:bg-[#c9a448]/15">
              {icon}
            </div>
            <span class="font-body text-[10px] font-semibold leading-tight text-white/50 transition-colors group-hover:text-white/80">{label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── BANNER KOPER ───────────────────────────────────────── -->
  <section class="bg-[#0d0d0d] py-16" aria-labelledby="banner-heading">
    <div class="container-page">
      <div class="gold-line"></div>
      <h2 id="banner-heading" class="mt-4 text-3xl text-white md:text-4xl">Koper PP Premium</h2>
      <p class="mt-2 max-w-xl text-white/50">Anti pecah, lentur & kuat — tersedia 20", 24" & 28" dengan pilihan warna bebas.</p>

      <div class="mt-8 grid gap-4 lg:grid-cols-[1.6fr_1fr]">
        <a href="/produk/koper-pp-premium-haji-umrah" class="card-lift img-zoom group relative block overflow-hidden rounded-3xl bg-[#1a1a1a]">
          <img
            src="/images/Katalog 2026/Katalog 2026_page-0001.jpg"
            alt="Koleksi koper Berkah Koper — warna & model lengkap Haji & Umrah"
            class="h-full min-h-64 w-full object-cover lg:min-h-80"
            loading="lazy" decoding="async" width="800" height="500"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent"></div>
          <div class="absolute bottom-5 left-5 right-5">
            <div class="text-xs font-bold uppercase tracking-widest text-[#c9a448]">Koper PP Premium</div>
            <div class="mt-1 font-display text-xl text-white md:text-2xl">Anti Pecah, Lentur & Kuat</div>
            <div class="mt-1 text-sm text-white/70">Lihat detail →</div>
          </div>
        </a>

        <a href="/produk/koper-pp-premium-haji-umrah" class="card-lift img-zoom group relative block overflow-hidden rounded-3xl bg-[#1a1a1a]">
          <img
            src="/images/Katalog 2026/Katalog 2026_page-0003.jpg"
            alt="Koper PP Polypropylene anti pecah — lentur dan kuat"
            class="h-full min-h-64 w-full object-cover object-top lg:min-h-80"
            loading="lazy" decoding="async" width="600" height="500"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
          <div class="absolute bottom-5 left-5 right-5">
            <div class="text-xs font-bold uppercase tracking-widest text-[#c9a448]">Bahan PP Polypropylene</div>
            <div class="mt-1 font-display text-xl text-white md:text-2xl">Anti Pecah!</div>
            <div class="mt-1 text-sm text-white/80">Tersedia uk. 20", 24" & 28"</div>
          </div>
        </a>
      </div>

      <div class="mt-5 flex flex-wrap gap-3">
        <a href="/produk/koper-pp-premium-haji-umrah" class="btn-primary">Koper PP Premium →</a>
        <a href="/katalog?kategori=koper" class="btn-outline">Semua Koper →</a>
      </div>
    </div>
  </section>

  <!-- ── PRODUK UNGGULAN ───────────────────────────────────── -->
  <section class="bg-[#0d0d0d] py-16" aria-labelledby="featured-heading">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <div class="gold-line"></div>
          <h2 id="featured-heading" class="mt-4 text-3xl text-white md:text-4xl">Produk Unggulan</h2>
          <p class="mt-2 text-white/50">Pilihan yang paling banyak diminati jamaah.</p>
        </div>
        <a href="/katalog" class="btn-outline">Lihat Semua →</a>
      </div>

      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {featured.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    </div>
  </section>

  <!-- ── BUNDLING ───────────────────────────────────────────── -->
  <section id="bundling" class="bg-[#111111] py-16" aria-labelledby="bundling-heading">
    <div class="container-page">
      <div class="gold-line"></div>
      <h2 id="bundling-heading" class="mt-4 text-3xl text-white md:text-4xl">Paket Bundling</h2>
      <p class="mt-2 text-white/50">Hemat lebih besar dengan paket lengkap sekaligus.</p>

      <div class="mt-8 flex flex-col gap-6">
        {bundles.map((product) => (
          <BundleCard product={product} />
        ))}
      </div>
    </div>
  </section>

  <!-- ── KENAPA Berkah Koper ──────────────────────────────────── -->
  <section id="tentang" class="bg-[#0d0d0d] py-16" aria-labelledby="whyus-heading">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-[.9fr_1.1fr] lg:gap-12">
        <div>
          <div class="gold-line"></div>
          <h2 id="whyus-heading" class="mt-4 text-3xl text-white md:text-4xl">{tentang.heading}</h2>
          <p class="mt-4 leading-7 text-white/50">
            {tentang.description}
          </p>
        </div>
        <!-- mt sejajar judul kiri (bukan gold-line) agar card tidak nempel sticky header -->
        <div class="grid gap-4 sm:grid-cols-2 lg:mt-7">
          {tentang.items.map(({ icon, title, desc }) => (
            <div class="group rounded-xl border border-white/8 bg-[#161616] p-5 transition-all hover:border-[#c9a448]/25 hover:bg-[#c9a448]/4">
              <div class="mb-4 flex size-9 items-center justify-center rounded-lg border border-[#c9a448]/20 bg-[#c9a448]/8 text-base">
                {icon}
              </div>
              <h3 class="font-body text-sm font-bold text-white/90">{title}</h3>
              <p class="mt-1.5 text-xs leading-5 text-white/45">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── MITRA TOUR / CLIENT ─────────────────────────────────── -->
  {mitra.partners.length > 0 && (
    <section
      id="mitra"
      class="mitra-section overflow-hidden py-16"
      aria-labelledby="mitra-heading"
    >
      <div class="container-page">
        <div class="gold-line"></div>
        <p class="mt-4 text-xs font-bold uppercase tracking-[0.22em] text-[#c9a448]">
          {mitra.eyebrow}
        </p>
        <h2 id="mitra-heading" class="mt-3 text-3xl text-white md:text-4xl">
          {mitra.heading}
        </h2>
        <p class="mt-2 max-w-xl text-white/50">
          {mitra.description}
        </p>
        <p class="mt-3 text-sm font-semibold text-white/35">
          {mitra.partners.length}+ biro & travel partner
        </p>

        <div class="mitra-marquee mt-8" aria-label="Logo mitra travel">
          <div class="mitra-track" style={`--mitra-duration: ${Math.max(40, mitraRowA.length * 3)}s`}>
            {[...mitraRowA, ...mitraRowA].map((partner) => (
              <div class="mitra-logo" title={partner.name}>
                <img
                  src={partner.src}
                  alt={partner.name}
                  loading="lazy"
                  decoding="async"
                  width="220"
                  height="110"
                />
              </div>
            ))}
          </div>
          {mitraRowB.length > 0 && (
            <div
              class="mitra-track mitra-track--reverse mt-4"
              style={`--mitra-duration: ${Math.max(45, mitraRowB.length * 3.2)}s`}
            >
              {[...mitraRowB, ...mitraRowB].map((partner) => (
                <div class="mitra-logo" title={partner.name}>
                  <img
                    src={partner.src}
                    alt={partner.name}
                    loading="lazy"
                    decoding="async"
                    width="220"
                    height="110"
                  />
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- ── CTA BANNER ────────────────────────────────────────── -->
  <section class="py-16" style="background:linear-gradient(135deg,#1a1400 0%,#0d0d0d 100%);border-top:1px solid rgba(201,164,72,.2);border-bottom:1px solid rgba(201,164,72,.2)" aria-label="Hubungi kami">
    <div class="container-page flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
      <div>
        <div class="text-sm font-bold uppercase tracking-widest text-[#c9a448]">Siap berangkat?</div>
        <h2 class="mt-2 max-w-xl text-3xl text-white md:text-4xl">Lengkapi perlengkapan ibadah Anda sekarang.</h2>
      </div>
      <div class="flex shrink-0 flex-wrap gap-3">
        <a href="/katalog" class="btn-outline-gold">
          Lihat Katalog
        </a>
        <a
          href={buildWaLink("Assalamu'alaikum Berkah Koper, saya ingin tanya produk.")}
          class="btn-primary"
          target="_blank"
          rel="noopener noreferrer"
        >
          Chat WhatsApp →
        </a>
      </div>
    </div>
  </section>
</Layout>
