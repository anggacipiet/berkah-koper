---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import BundleCard from '../components/BundleCard.astro';
import { getFeaturedProducts, getBundleProducts } from '../data/products';
import { getHero, siteWaLink } from '../data/hero';
import { getTentang } from '../data/tentang';
import { getMitra } from '../data/mitra';
import { getKatalogDownload } from '../data/katalog';
import { getPromo } from '../data/promo';
import { CATALOG_CATEGORIES } from '../types/product';
import { responsiveImage } from '../lib/media';

export const prerender = true;

const featured = getFeaturedProducts(4);
const bundles = getBundleProducts();
const hero = getHero();
const tentang = getTentang();
const mitra = getMitra();
const katalogDl = getKatalogDownload();
const promo = getPromo();
const promoCards = promo.cards.slice(0, 4).map((card) => ({
  ...card,
  href: card.href,
  img: responsiveImage(card.image, '(max-width: 768px) 100vw, 50vw'),
}));
const ctaWaUrl = siteWaLink(hero.waMessage);
const mitraRowA = mitra.partners.filter((_, i) => i % 2 === 0);
const mitraRowB = mitra.partners.filter((_, i) => i % 2 === 1);
const heroSlides = hero.slides.map((slide) => ({
  ...slide,
  img: responsiveImage(slide.src, '(max-width: 1023px) 100vw, 520px'),
}));

const kickerClass = 'inline-flex items-center gap-3 text-[0.68rem] font-bold uppercase tracking-[0.2em] text-[#8a6518]';
const outlineBtn =
  'inline-flex items-center justify-center gap-1.5 rounded-full border border-[#c9a448] bg-transparent px-5 py-3 text-sm font-semibold text-[#161412] no-underline transition hover:bg-[#c9a448] hover:text-[#111]';
const sectionHeadH2 = 'mt-3 font-display text-[clamp(1.75rem,3.2vw,2.4rem)] font-semibold leading-[1.15] text-[#161412]';
const sectionHeadP = 'mt-3 max-w-[34rem] text-[0.92rem] leading-[1.7] text-[#5c5854]';
---

<Layout canonicalPath="/">
  <section class="bg-white lg:flex lg:h-[calc(100svh-4.25rem)] lg:max-h-[calc(100svh-4.25rem)] lg:flex-col lg:overflow-hidden" aria-labelledby="hero-heading">
    <div class="container-page flex flex-col gap-[1.15rem] py-[1.35rem] lg:grid lg:min-h-0 lg:flex-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.95fr)] lg:items-center lg:gap-10 lg:py-5">
      <div class="contents max-w-xl lg:block lg:max-w-[36rem]">
        <div class={`${kickerClass} order-1 animate-fade-up`}>
          <span class="h-px w-7 bg-[#c9a448]" aria-hidden="true"></span>
          {hero.eyebrow.replace(/^✦\s*/, '')}
        </div>
        <h1 id="hero-heading" class="order-2 mt-0 font-display text-[clamp(1.9rem,6.5vw,2.85rem)] font-semibold leading-[1.08] tracking-[-0.02em] text-[#161412] animate-fade-up animate-fade-up-d1 lg:mt-3">
          {hero.headline}<br />
          <em class="font-display font-semibold italic text-[#8a6518]">{hero.headlineAccent.trim()}</em>
        </h1>
        <div class="order-5 mt-0 max-w-[34rem] space-y-2 text-[0.9rem] leading-[1.65] text-[#5c5854] animate-fade-up animate-fade-up-d2 lg:order-none lg:mt-3.5">
          {hero.paragraphs.map((p) => <p>{p}</p>)}
        </div>
        <div class="order-3 mt-0.5 flex flex-wrap gap-2.5 animate-fade-up animate-fade-up-d3 lg:order-none lg:mt-4">
          <a href="/katalog" class="btn-primary min-h-11">{hero.primaryCtaLabel}</a>
          <a href={hero.secondaryCtaHref} class={`${outlineBtn} min-h-11`} target="_blank" rel="noopener noreferrer">{hero.secondaryCtaLabel}</a>
        </div>
      </div>

      {heroSlides.length > 0 && (
        <div
          class="relative order-4 w-full min-w-0 animate-fade-up animate-fade-up-d2 lg:order-none lg:flex lg:h-full lg:min-h-0 lg:flex-col lg:justify-center"
          id="v2-hero-carousel"
          aria-roledescription="carousel"
          aria-label="Foto produk unggulan"
        >
          <figure class="m-0 mx-auto w-full max-w-[min(100%,28rem)] overflow-hidden border border-[#c9a448]/40 bg-white shadow-[0_18px_40px_rgba(17,17,17,0.06)] leading-[0] lg:mx-0 lg:h-full lg:max-h-full lg:max-w-[min(100%,calc((100svh-8.5rem)*0.707))] lg:w-auto lg:self-center">
            <div class="relative aspect-[1131/1600] w-full bg-white lg:h-full lg:max-h-full lg:w-auto lg:max-w-full">
              {heroSlides.map((slide, i) => (
                <div
                  class:list={[
                    'v2-hero-slide absolute inset-0 bg-white opacity-0 invisible pointer-events-none transition-[opacity,visibility] duration-500',
                    i === 0 && 'is-active opacity-100 visible pointer-events-auto z-[1]',
                  ]}
                  role="group"
                  aria-roledescription="slide"
                  aria-label={`${i + 1} dari ${heroSlides.length}`}
                  aria-hidden={i === 0 ? 'false' : 'true'}
                >
                  <img
                    src={slide.img.src}
                    srcset={slide.img.srcset}
                    sizes="(max-width: 1023px) 100vw, 520px"
                    alt={slide.alt}
                    class:list={[
                      'absolute inset-0 h-full w-full bg-white object-cover',
                      i === 0 ? 'object-center' : 'object-top',
                    ]}
                    width="520"
                    height="736"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    fetchpriority={i === 0 ? 'high' : 'auto'}
                  />
                </div>
              ))}
            </div>
          </figure>
        </div>
      )}
    </div>

    <script>
      function initV2HeroCarousel() {
        const root = document.getElementById('v2-hero-carousel');
        if (!root) return;
        const slides = Array.from(root.querySelectorAll<HTMLElement>('.v2-hero-slide'));
        if (slides.length < 2) return;

        let index = 0;
        let timer: ReturnType<typeof setInterval> | undefined;

        const goTo = (next: number) => {
          index = ((next % slides.length) + slides.length) % slides.length;
          slides.forEach((slide, i) => {
            const on = i === index;
            slide.classList.toggle('is-active', on);
            slide.classList.toggle('opacity-100', on);
            slide.classList.toggle('visible', on);
            slide.classList.toggle('pointer-events-auto', on);
            slide.classList.toggle('z-[1]', on);
            slide.classList.toggle('opacity-0', !on);
            slide.classList.toggle('invisible', !on);
            slide.classList.toggle('pointer-events-none', !on);
            slide.setAttribute('aria-hidden', on ? 'false' : 'true');
          });
        };

        const start = () => {
          if (timer) clearInterval(timer);
          timer = setInterval(() => goTo(index + 1), 4200);
        };

        root.addEventListener('mouseenter', () => {
          if (timer) clearInterval(timer);
        });
        root.addEventListener('mouseleave', start);

        goTo(0);
        start();
      }
      initV2HeroCarousel();
    </script>

    <div class="shrink-0 border-y border-[#e8e8e8]">
      <div class="container-page grid gap-3 py-4 sm:grid-cols-3 sm:gap-0 sm:divide-x sm:divide-[#e8e8e8] sm:py-5">
        {hero.trustItems.map((item, i) => (
          <div class="flex items-center gap-2.5 text-[0.78rem] font-semibold tracking-[0.04em] text-[#161412] sm:justify-center sm:px-4">
            <span class="font-display text-[1.15rem] font-bold text-[#8a6518]" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            {item}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-9 md:py-11" aria-labelledby="kategori-heading">
    <div class="container-page">
      <div>
        <div class={kickerClass}>
          <span class="h-px w-7 bg-[#c9a448]" aria-hidden="true"></span>
          Koleksi
        </div>
        <h2 id="kategori-heading" class={sectionHeadH2}>Belanja Berdasarkan Kategori</h2>
      </div>
      <div class="mt-8 grid border-y border-[#e8e8e8] md:grid-cols-4">
        {CATALOG_CATEGORIES.map((c, i) => (
          <a
            href={`/katalog?kategori=${c.value}`}
            class="flex flex-col gap-2 border-b border-[#e8e8e8] px-[1.1rem] py-6 no-underline transition-colors hover:bg-[#c9a448]/5 md:border-b-0 md:border-r md:last:border-r-0"
            aria-label={`Lihat katalog kategori ${c.label}`}
          >
            <span class="font-display text-[0.95rem] tracking-[0.08em] text-[#8a6518]">{String(i + 1).padStart(2, '0')}</span>
            <span class="text-[0.92rem] font-semibold leading-snug text-[#161412] transition-colors group-hover:text-[#8a6518] hover:text-[#8a6518]">{c.label}</span>
            <span class="text-[0.7rem] uppercase tracking-[0.12em] text-[#5c5854]">Lihat koleksi →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-9 md:py-11" aria-labelledby="biz-heading">
    <div class="container-page">
      <div>
        <div class={kickerClass}>
          <span class="h-px w-7 bg-[#c9a448]" aria-hidden="true"></span>
          B2B
        </div>
        <h2 id="biz-heading" class={sectionHeadH2}>Grosir &amp; Kemitraan</h2>
        <p class={sectionHeadP}>Untuk travel, biro, reseller, dan toko yang butuh stok stabil dengan harga pabrik.</p>
      </div>
      <div class="mt-8 grid border-y border-[#e8e8e8] md:grid-cols-2">
        <a href="/grosir" class="block border-b border-[#e8e8e8] px-5 py-8 text-inherit no-underline transition-colors hover:bg-[#c9a448]/[0.06] md:border-b-0 md:border-r md:px-7 md:py-9">
          <div class="text-[10px] font-bold uppercase tracking-[.18em] text-[#8a6518]">01 · Grosir</div>
          <div class="mt-2.5 font-display text-[1.85rem] leading-[1.15] text-[#161412]">Ambil stok harga pabrik</div>
          <p class="mt-2.5 max-w-[28rem] text-[0.9rem] leading-[1.65] text-[#5c5854]">Order dalam jumlah besar untuk kloter atau toko — custom logo &amp; warna tersedia.</p>
          <span class="mt-4 inline-block text-[0.72rem] font-bold uppercase tracking-[0.14em] text-[#161412] transition-colors hover:text-[#8a6518]">Pelajari grosir →</span>
        </a>
        <a href="/kemitraan" class="block px-5 py-8 text-inherit no-underline transition-colors hover:bg-[#c9a448]/[0.06] md:px-7 md:py-9">
          <div class="text-[10px] font-bold uppercase tracking-[.18em] text-[#8a6518]">02 · Kemitraan</div>
          <div class="mt-2.5 font-display text-[1.85rem] leading-[1.15] text-[#161412]">Gabung jadi mitra resmi</div>
          <p class="mt-2.5 max-w-[28rem] text-[0.9rem] leading-[1.65] text-[#5c5854]">Skema harga mitra, dukungan katalog, dan prioritas stok untuk kerja sama jangka panjang.</p>
          <span class="mt-4 inline-block text-[0.72rem] font-bold uppercase tracking-[0.14em] text-[#161412] transition-colors hover:text-[#8a6518]">Pelajari kemitraan →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-white py-9 md:py-11" aria-labelledby="banner-heading">
    <div class="container-page">
      <div class="flex flex-col items-start gap-5 md:flex-row md:items-end md:justify-between md:gap-6">
        <div>
          <div class={kickerClass}>
            <span class="h-px w-7 bg-[#c9a448]" aria-hidden="true"></span>
            Sorotan
          </div>
          <h2 id="banner-heading" class={sectionHeadH2}>{promo.heading}</h2>
          <p class={sectionHeadP}>{promo.description}</p>
        </div>
        <a href="/katalog" class={`${outlineBtn} shrink-0`}>{promo.secondaryCtaLabel}</a>
      </div>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:gap-6">
        {promoCards.map((card, i) => (
          <a
            href={card.href}
            class="group relative block aspect-[4/5] overflow-hidden border border-[#c9a448]/40 bg-[#f3f1ee] text-inherit no-underline shadow-[0_18px_40px_rgba(17,17,17,0.06)]"
          >
            <img
              src={card.img.src}
              srcset={card.img.srcset}
              sizes={card.img.sizes}
              alt={card.alt}
              class:list={[
                'absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]',
                i === 1 ? 'object-top' : 'object-center',
              ]}
              loading="lazy"
              decoding="async"
              width="600"
              height="750"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/15 to-transparent" aria-hidden="true"></div>
            <div class="absolute inset-x-0 bottom-0 p-5 sm:p-6">
              <div class="text-[10px] font-bold uppercase tracking-[.18em] text-[#8a6518]">{card.eyebrow}</div>
              <div class="mt-1 font-display text-2xl text-white sm:text-[1.65rem]">{card.title}</div>
              <div class="mt-0.5 text-sm text-white/80">{card.subtitle}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-9 md:py-11" aria-labelledby="featured-heading">
    <div class="container-page">
      <div class="flex flex-col items-start gap-5 md:flex-row md:items-end md:justify-between md:gap-6">
        <div>
          <div class={kickerClass}>
            <span class="h-px w-7 bg-[#c9a448]" aria-hidden="true"></span>
            Unggulan
          </div>
          <h2 id="featured-heading" class={sectionHeadH2}>Produk Unggulan</h2>
          <p class={sectionHeadP}>Pilihan yang paling banyak diminati jamaah.</p>
        </div>
        <a href="/katalog" class={`${outlineBtn} shrink-0`}>Lihat Semua →</a>
      </div>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-4">
        {featured.map((product) => <ProductCard product={product} />)}
      </div>
    </div>
  </section>

  <section id="bundling" class="bg-white py-11 md:py-12" aria-labelledby="bundling-heading">
    <div class="container-page">
      <div>
        <div class={kickerClass}>
          <span class="h-px w-7 bg-[#c9a448]" aria-hidden="true"></span>
          Paket
        </div>
        <h2 id="bundling-heading" class={sectionHeadH2}>Paket Bundling</h2>
        <p class={sectionHeadP}>Hemat lebih besar dengan paket lengkap sekaligus.</p>
      </div>
      <div class="mt-10 flex flex-col gap-6">
        {bundles.map((product) => <BundleCard product={product} />)}
      </div>
    </div>
  </section>

  <section id="tentang" class="bg-white py-11 md:py-12" aria-labelledby="whyus-heading">
    <div class="container-page grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <div>
        <div class={kickerClass}>
          <span class="h-px w-7 bg-[#c9a448]" aria-hidden="true"></span>
          Tentang
        </div>
        <h2 id="whyus-heading" class={sectionHeadH2}>{tentang.heading}</h2>
        <p class={`${sectionHeadP} whitespace-pre-line`}>{tentang.description}</p>
      </div>
      <div class="grid border-t border-[#e8e8e8] sm:grid-cols-2 lg:mt-2">
        {tentang.items.map(({ title, desc }, i) => (
          <article class={`border-b border-[#e8e8e8] py-6 sm:px-6 sm:py-7 ${i % 2 === 0 ? 'sm:pl-0 sm:border-r' : 'sm:pr-0'}`}>
            <div class="font-display text-[1.35rem] leading-none text-[#8a6518]">{String(i + 1).padStart(2, '0')}</div>
            <h3 class="mt-3 font-display text-[1.35rem] font-semibold leading-snug text-[#161412]">{title}</h3>
            <p class="mt-2 text-[0.9rem] leading-[1.65] text-[#5c5854]">{desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {mitra.partners.length > 0 && (
    <section id="mitra" class="mitra-section overflow-hidden bg-white py-12 md:py-[3.75rem]" aria-labelledby="mitra-heading">
      <div class="container-page">
        <div>
          <div class={kickerClass}>
            <span class="h-px w-7 bg-[#c9a448]" aria-hidden="true"></span>
            Partner
          </div>
          <h2 id="mitra-heading" class={sectionHeadH2}>{mitra.heading}</h2>
          <p class={sectionHeadP}>{mitra.description}</p>
          <p class="mt-3 text-[0.72rem] font-bold uppercase tracking-[0.14em] text-[#8a6518]">{mitra.partners.length}+ biro &amp; travel partner</p>
        </div>
        <div class="mitra-marquee mt-8 border-0 bg-transparent" aria-label="Logo mitra travel">
          <div class="mitra-track" style={`--mitra-duration: ${Math.max(40, mitraRowA.length * 3)}s`}>
            {[...mitraRowA, ...mitraRowA].map((partner) => (
              <div class="mitra-logo border-0 bg-transparent shadow-none" title={partner.name}>
                <img src={partner.src} alt={partner.name} loading="lazy" decoding="async" width="220" height="110" />
              </div>
            ))}
          </div>
          {mitraRowB.length > 0 && (
            <div class="mitra-track mitra-track--reverse mt-4" style={`--mitra-duration: ${Math.max(45, mitraRowB.length * 3.2)}s`}>
              {[...mitraRowB, ...mitraRowB].map((partner) => (
                <div class="mitra-logo border-0 bg-transparent shadow-none" title={partner.name}>
                  <img src={partner.src} alt={partner.name} loading="lazy" decoding="async" width="220" height="110" />
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <section class="border-y border-[#8a6518]/55 bg-[#8a6518] py-14 text-white md:py-16" aria-label="Hubungi kami">
    <div class="container-page flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
      <div>
        <div class="text-[10px] font-bold uppercase tracking-[.2em] text-white">{katalogDl.eyebrow}</div>
        <h2 class="mt-3 max-w-xl font-display text-3xl font-semibold text-white md:text-4xl">{katalogDl.heading}</h2>
      </div>
      <div class="flex w-full shrink-0 flex-col gap-3 sm:w-auto sm:flex-row sm:flex-wrap">
        <a href="/katalog" class="inline-flex min-h-[2.85rem] items-center justify-center rounded-full border-[1.5px] border-white bg-transparent px-6 py-3 text-[0.88rem] font-bold tracking-[0.02em] text-white no-underline transition hover:bg-white hover:text-[#8a6518]">Lihat Katalog →</a>
        <a href={ctaWaUrl} class="inline-flex min-h-[2.85rem] items-center justify-center gap-1.5 rounded-full border-[1.5px] border-white bg-transparent px-6 py-3 text-[0.88rem] font-bold tracking-[0.02em] text-white no-underline transition hover:bg-white hover:text-[#8a6518]" target="_blank" rel="noopener noreferrer" aria-label="Chat WhatsApp dari banner Siap Berangkat">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4 shrink-0" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Chat WhatsApp
        </a>
      </div>
    </div>
  </section>
</Layout>
