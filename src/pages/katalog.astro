---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import SearchBar from '../components/SearchBar.astro';
import { getAllProducts } from '../data/products';
import { siteWaLink } from '../data/hero';

export const prerender = true;

const allProducts = getAllProducts();
const waSearch = siteWaLink("Assalamu'alaikum Berkah Koper, saya mencari produk tertentu.");
const waConsult = siteWaLink("Assalamu'alaikum Berkah Koper, saya ingin konsultasi produk.");
---

<Layout canonicalPath="/katalog/">
  <div class="min-h-screen bg-white">
    <header class="border-b border-[#e8e8e8] bg-white py-7 lg:py-9">
      <div class="container-page">
        <div class="inline-flex items-center gap-3 text-[0.68rem] font-bold uppercase tracking-[0.2em] text-[#c9a448]"><span class="h-px w-7 bg-[#c9a448]" aria-hidden="true"></span>Koleksi</div>
        <h1 class="mt-[0.55rem] font-display text-[clamp(2.35rem,4.5vw,3.25rem)] font-semibold leading-[1.05] tracking-[-0.02em] text-[#161412]">Katalog Produk</h1>
        <p id="result-count" class="mt-3 max-w-xl text-[0.95rem] leading-[1.7] text-[#5c5854]">{allProducts.length} produk</p>
      </div>
    </header>

    <div class="container-page py-10">
      <div class="flex flex-col gap-5">
        <SearchBar value="" action="/katalog" light />
        <div class="overflow-x-auto pb-1">
          <CategoryFilter basePath="/katalog" light />
        </div>
      </div>

      <div id="product-grid" class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {allProducts.map((product) => (
          <div class="product-item" data-name={product.name.toLowerCase()} data-desc={product.shortDesc.toLowerCase()} data-category={product.category}>
            <ProductCard product={product} />
          </div>
        ))}
      </div>

      <div id="empty-state" class="mt-16 hidden flex-col items-center gap-4 text-center">
        <h2 class="font-display text-3xl text-[#161412]">Produk tidak ditemukan</h2>
        <p class="max-w-sm text-sm text-[#5c5854]">Coba kata kunci lain atau pilih kategori berbeda.</p>
        <div class="flex gap-3">
          <a href="/katalog" class="btn-primary">Lihat Semua</a>
          <a href={waSearch} class="inline-flex items-center justify-center gap-1.5 rounded-full border border-[#c9a448] bg-transparent px-5 py-3 text-sm font-semibold text-[#161412] no-underline transition hover:bg-[#c9a448] hover:text-[#111]" target="_blank" rel="noopener noreferrer">Tanya via WA</a>
        </div>
      </div>

      <div id="cta-section" class="mt-16 border border-[#a07828]/55 bg-[#a07828] px-8 py-12 text-center text-white md:py-14">
        <div class="inline-flex items-center justify-center gap-3 text-[0.68rem] font-bold uppercase tracking-[0.2em] text-white/90"><span class="h-px w-7 bg-white/70" aria-hidden="true"></span>Bantuan</div>
        <h2 class="mt-3 font-display text-3xl font-semibold text-white md:text-4xl">Tanya langsung ke tim kami.</h2>
        <p class="mx-auto mt-2 max-w-md text-sm text-white/80">Ceritakan kebutuhan Anda dan kami bantu temukan produk yang paling sesuai.</p>
        <a href={waConsult} class="mt-6 inline-flex min-h-[2.85rem] items-center justify-center gap-1.5 rounded-full border-[1.5px] border-white/55 bg-white/15 px-6 py-3 text-[0.88rem] font-bold tracking-[0.02em] text-white no-underline backdrop-blur-sm transition hover:border-white hover:bg-white hover:text-[#a07828]" target="_blank" rel="noopener noreferrer">Konsultasi via WhatsApp</a>
      </div>
    </div>
  </div>
</Layout>

<script>
  const items = document.querySelectorAll<HTMLElement>('.product-item');
  const countEl = document.getElementById('result-count');
  const emptyEl = document.getElementById('empty-state');
  const ctaEl = document.getElementById('cta-section');
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;

  function applyFilter() {
    const params = new URLSearchParams(window.location.search);
    const kategori = params.get('kategori') ?? 'semua';
    const q = (params.get('q') ?? '').trim().toLowerCase();
    let visible = 0;
    items.forEach((item) => {
      const name = item.dataset.name ?? '';
      const desc = item.dataset.desc ?? '';
      const category = item.dataset.category ?? '';
      const matchCat = kategori === 'semua' || category === kategori;
      const matchQ = !q || name.includes(q) || desc.includes(q) || category.includes(q);
      if (matchCat && matchQ) {
        item.style.display = '';
        visible++;
      } else {
        item.style.display = 'none';
      }
    });
    if (countEl) countEl.textContent = `${visible} produk ditemukan`;
    if (emptyEl) emptyEl.classList.toggle('hidden', visible > 0);
    if (emptyEl) emptyEl.classList.toggle('flex', visible === 0);
    if (ctaEl) ctaEl.classList.toggle('hidden', visible === 0);
    if (searchInput && q) searchInput.value = q;
  }

  applyFilter();
  window.addEventListener('popstate', applyFilter);

  const searchForm = document.querySelector<HTMLFormElement>('form[role="search"]');
  searchForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const q = searchInput?.value.trim() ?? '';
    const params = new URLSearchParams(window.location.search);
    if (q) params.set('q', q); else params.delete('q');
    history.pushState({}, '', `/katalog${params.size ? '?' + params : ''}`);
    applyFilter();
  });
</script>
