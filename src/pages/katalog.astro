---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import SearchBar from '../components/SearchBar.astro';
import { getAllProducts } from '../data/products';
import type { ProductCategory } from '../types/product';
import { CATEGORY_LABELS } from '../types/product';

const url      = Astro.url;
const kategori = url.searchParams.get('kategori') ?? 'semua';
const q        = (url.searchParams.get('q') ?? '').trim().toLowerCase();

let products = getAllProducts();
if (kategori && kategori !== 'semua') products = products.filter((p) => p.category === kategori);
if (q) {
  products = products.filter(
    (p) =>
      p.name.toLowerCase().includes(q) ||
      p.shortDesc.toLowerCase().includes(q) ||
      p.category.toLowerCase().includes(q),
  );
}

const katLabel = kategori !== 'semua'
  ? CATEGORY_LABELS[kategori as ProductCategory] ?? kategori
  : 'Semua Produk';

const pageTitle = q
  ? `Hasil "${q}" — Berkah Koper`
  : `${katLabel} — Katalog Berkah Koper`;

const pageDesc = `Katalog supplier koper dan tas Haji & Umrah — ${katLabel.replace(/^[^ ]+ /, '')}. Bahan ABS, PC, PP anti pecah. Harga pabrik.`;
---

<Layout title={pageTitle} description={pageDesc}>
  <div class="min-h-screen bg-[#0d0d0d]">

    <!-- ── Header halaman ────────────────────────────────── -->
    <div class="border-b border-white/10 bg-[#111111] py-8">
      <div class="container-page">
        <!-- Breadcrumb -->
        <nav class="mb-3 flex items-center gap-1.5 text-xs text-white/30" aria-label="Breadcrumb">
          <a href="/" class="hover:text-[#c9a448] transition-colors">Beranda</a>
          <span aria-hidden="true">/</span>
          <span class="text-white/60">Katalog</span>
          {kategori !== 'semua' && (
            <>
              <span aria-hidden="true">/</span>
              <span class="text-white/60">{katLabel}</span>
            </>
          )}
        </nav>

        <h1 class="text-2xl font-black text-white">
          {q ? `Hasil pencarian: "${q}"` : katLabel}
        </h1>
        <p class="mt-1 text-sm text-white/40">
          {products.length} produk ditemukan
        </p>
      </div>
    </div>

    <div class="container-page py-8">
      <!-- ── Search + Filter ─────────────────────────────── -->
      <div class="flex flex-col gap-5">
        <SearchBar value={q} action="/katalog" />
        <div class="overflow-x-auto pb-1">
          <CategoryFilter basePath="/katalog" />
        </div>
      </div>

      <!-- ── Grid produk ─────────────────────────────────── -->
      {products.length > 0 ? (
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {products.map((product) => (
            <ProductCard product={product} />
          ))}
        </div>
      ) : (
        <div class="mt-16 flex flex-col items-center gap-4 text-center">
          <div class="text-6xl" aria-hidden="true">🔍</div>
          <h2 class="text-xl font-bold text-white">Produk tidak ditemukan</h2>
          <p class="max-w-sm text-sm text-white/50">
            {q
              ? `Tidak ada produk yang cocok dengan "${q}". Coba kata kunci lain atau lihat semua produk.`
              : `Belum ada produk di kategori ini.`}
          </p>
          <div class="flex gap-3">
            <a href="/katalog" class="btn-primary">Lihat Semua Produk</a>
            <a
              href="https://wa.me/6285282400061?text=Assalamu%27alaikum%20Berkah%20Koper%2C%20saya%20mencari%20produk%20tertentu."
              class="btn-wa"
              target="_blank"
              rel="noopener noreferrer"
            >
              Tanya via WA
            </a>
          </div>
        </div>
      )}

      <!-- ── CTA bawah ───────────────────────────────────── -->
      {products.length > 0 && (
        <div class="mt-16 overflow-hidden rounded-3xl border border-[#c9a448]/25 bg-[#111111] p-8 text-center">
          <div class="text-xs font-bold uppercase tracking-widest text-[#c9a448]">Tidak menemukan yang cocok?</div>
          <h2 class="mt-2 text-2xl font-black text-white">Tanya langsung ke tim kami.</h2>
          <p class="mx-auto mt-2 max-w-md text-sm text-white/50">
            Ceritakan kebutuhan perjalanan Anda dan kami bantu temukan produk yang paling sesuai.
          </p>
          <a
            href="https://wa.me/6285282400061?text=Assalamu%27alaikum%20Berkah%20Koper%2C%20saya%20ingin%20konsultasi%20produk."
            class="btn-wa mt-6 inline-flex"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Konsultasi via WhatsApp
          </a>
        </div>
      )}
    </div>
  </div>
</Layout>
