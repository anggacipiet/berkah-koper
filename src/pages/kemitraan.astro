---
import Layout from '../layouts/Layout.astro';
import { siteWaLink } from '../data/hero';

export const prerender = true;

const waUrl = siteWaLink(
  "Assalamu'alaikum Berkah Koper, saya ingin tanya program kemitraan / reseller koper umroh.",
);

const benefits = [
  {
    title: 'Margin lebih jelas',
    desc: 'Harga mitra khusus sehingga Anda bisa menjual ulang dengan ruang keuntungan yang sehat.',
  },
  {
    title: 'Dukungan katalog',
    desc: 'Akses foto & spesifikasi produk untuk membantu penawaran ke jamaah atau toko.',
  },
  {
    title: 'Prioritas stok',
    desc: 'Pesanan mitra diprioritaskan agar kebutuhan kloter tidak terlambat.',
  },
  {
    title: 'Custom brand travel',
    desc: 'Bantu identitas biro Anda lewat logo, warna, dan packing yang konsisten.',
  },
];

const steps = [
  { title: 'Konsultasi', desc: 'Ceritakan model bisnis Anda: reseller, toko, atau biro travel.' },
  { title: 'Skema mitra', desc: 'Kami jelaskan harga mitra, MOQ, dan opsi custom.' },
  { title: 'Mulai order', desc: 'Pesanan pertama jalan — lanjut kerja sama jangka panjang.' },
];
---

<Layout
  title="Kemitraan Reseller Koper Umroh"
  description="Program kemitraan & reseller koper umroh: harga mitra, dukungan katalog, prioritas stok, custom logo travel. Cocok untuk biro, toko, dan reseller."
  canonicalPath="/kemitraan/"
>
  <div class="min-h-screen bg-white">
    <header class="border-b border-[#e8e8e8] bg-white py-7 lg:py-9">
      <div class="container-page grid items-center gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-20">
        <div>
          <div class="inline-flex items-center gap-3 text-[0.68rem] font-bold uppercase tracking-[0.2em] text-[#8a6518]"><span class="h-px w-7 bg-[#c9a448]" aria-hidden="true"></span>Partner</div>
          <h1 class="mt-[0.55rem] font-display text-[clamp(2.35rem,4.5vw,3.25rem)] font-semibold leading-[1.05] tracking-[-0.02em] text-[#161412]">Kemitraan Reseller Koper Umroh</h1>
          <p class="mt-3 max-w-xl text-[0.95rem] leading-[1.7] text-[#5c5854]">
            Kerja sama untuk travel, reseller &amp; toko — harga mitra, stok stabil, custom logo.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href={waUrl} class="btn-primary" target="_blank" rel="noopener noreferrer">Gabung Kemitraan</a>
            <a href="/katalog" class="inline-flex items-center justify-center gap-1.5 rounded-full border border-[#c9a448] bg-transparent px-5 py-3 text-sm font-semibold text-[#161412] no-underline transition hover:bg-[#c9a448] hover:text-[#111]">Lihat Katalog</a>
          </div>
        </div>

        <aside class="relative border border-[#e8e8e8] bg-white px-6 pb-6 pt-7 before:absolute before:inset-x-0 before:top-0 before:h-0.5 before:bg-[#c9a448] before:content-[''] md:px-7 md:pb-7 md:pt-8" aria-label="Ringkasan kemitraan">
          <div class="text-[0.68rem] font-bold uppercase tracking-[0.18em] text-[#8a6518]">Ringkasan</div>
          <div class="mt-2 border-b border-[#e8e8e8] pb-4 font-display text-[1.55rem] font-semibold leading-[1.2] text-[#161412]">Program kemitraan</div>
          <ul class="mt-1 list-none p-0">
            <li class="flex items-baseline gap-3.5 border-b border-[#e8e8e8] py-3.5 text-[0.9rem] leading-[1.55] text-[#5c5854] last:border-b-0 last:pb-0"><span class="shrink-0 font-display text-base text-[#8a6518]" aria-hidden="true">01</span>Margin lebih jelas dengan harga mitra</li>
            <li class="flex items-baseline gap-3.5 border-b border-[#e8e8e8] py-3.5 text-[0.9rem] leading-[1.55] text-[#5c5854] last:border-b-0 last:pb-0"><span class="shrink-0 font-display text-base text-[#8a6518]" aria-hidden="true">02</span>Dukungan katalog untuk penawaran</li>
            <li class="flex items-baseline gap-3.5 border-b border-[#e8e8e8] py-3.5 text-[0.9rem] leading-[1.55] text-[#5c5854] last:border-b-0 last:pb-0"><span class="shrink-0 font-display text-base text-[#8a6518]" aria-hidden="true">03</span>Prioritas stok saat musim ramai</li>
            <li class="flex items-baseline gap-3.5 border-b border-[#e8e8e8] py-3.5 text-[0.9rem] leading-[1.55] text-[#5c5854] last:border-b-0 last:pb-0"><span class="shrink-0 font-display text-base text-[#8a6518]" aria-hidden="true">04</span>Custom brand travel (logo &amp; warna)</li>
          </ul>
        </aside>
      </div>
    </header>

    <section class="bg-white py-9 md:py-11" aria-labelledby="mitra-benefit-heading">
      <div class="container-page">
        <div>
          <div class="inline-flex items-center gap-3 text-[0.68rem] font-bold uppercase tracking-[0.2em] text-[#8a6518]"><span class="h-px w-7 bg-[#c9a448]" aria-hidden="true"></span>Manfaat</div>
          <h2 id="mitra-benefit-heading" class="mt-3 font-display text-[clamp(1.85rem,3vw,2.45rem)] font-semibold leading-[1.15] text-[#161412]">Yang Anda dapatkan</h2>
        </div>
        <div class="mt-10 grid border-t border-[#e8e8e8] sm:grid-cols-2">
          {benefits.map((p, i) => (
            <article class="border-b border-[#e8e8e8] pb-[1.65rem] pt-6 sm:border-r sm:px-6 sm:pb-[1.8rem] sm:pt-[1.7rem] sm:odd:pl-0 sm:even:border-r-0 sm:even:pr-0">
              <div class="font-display text-[1.35rem] leading-none text-[#8a6518]">{String(i + 1).padStart(2, '0')}</div>
              <h3 class="mt-3 font-display text-[1.35rem] font-semibold leading-[1.25] text-[#161412]">{p.title}</h3>
              <p class="mt-2 text-[0.9rem] leading-[1.65] text-[#5c5854]">{p.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-white py-9 md:py-11" aria-labelledby="mitra-step-heading">
      <div class="container-page">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-3 text-[0.68rem] font-bold uppercase tracking-[0.2em] text-[#8a6518]"><span class="h-px w-7 bg-[#c9a448]" aria-hidden="true"></span>Langkah</div>
          <h2 id="mitra-step-heading" class="mt-3 font-display text-[clamp(1.85rem,3vw,2.45rem)] font-semibold leading-[1.15] text-[#161412]">Mulai dalam 3 langkah</h2>
        </div>
        <div class="mt-10 grid border-t border-[#e8e8e8] md:grid-cols-3">
          {steps.map((s, i) => (
            <article class="border-b border-[#e8e8e8] py-[1.6rem] md:border-b-0 md:border-r md:px-6 md:py-[1.9rem] md:first:pl-0 md:last:border-r-0 md:last:pr-0">
              <div class="font-display text-[2rem] leading-none text-[#8a6518]">{String(i + 1).padStart(2, '0')}</div>
              <h3 class="mt-3.5 max-w-[16rem] font-display text-[1.2rem] font-semibold leading-[1.35] text-[#161412]">{s.title}</h3>
              <p class="mt-2 max-w-[16rem] text-[0.88rem] leading-[1.6] text-[#5c5854]">{s.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="border-y border-[#8a6518]/55 bg-[#8a6518] py-14 text-white" aria-label="Gabung kemitraan">
      <div class="container-page flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
        <div>
          <div class="text-[10px] font-bold uppercase tracking-[.2em] text-white">Kemitraan</div>
          <h2 class="mt-3 max-w-xl font-display text-3xl text-white md:text-4xl">Mari kerja sama untuk musim umroh berikutnya.</h2>
        </div>
        <div class="flex shrink-0 flex-wrap gap-3">
          <a href="/grosir" class="inline-flex min-h-[2.85rem] items-center justify-center gap-1.5 rounded-full border-[1.5px] border-white bg-transparent px-6 py-3 text-[0.88rem] font-bold tracking-[0.02em] text-white no-underline transition hover:bg-white hover:text-[#8a6518]">Lihat Grosir →</a>
          <a href={waUrl} class="inline-flex min-h-[2.85rem] items-center justify-center gap-1.5 rounded-full border-[1.5px] border-white bg-transparent px-6 py-3 text-[0.88rem] font-bold tracking-[0.02em] text-white no-underline transition hover:bg-white hover:text-[#8a6518]" target="_blank" rel="noopener noreferrer">Chat WhatsApp</a>
        </div>
      </div>
    </section>
  </div>
</Layout>
