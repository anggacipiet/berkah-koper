---
import Layout from '../layouts/Layout.astro';

export const prerender = true;

Astro.response.status = 404;
---

<Layout
  title="Halaman tidak ditemukan"
  description="Halaman yang Anda cari tidak ada. Kembali ke beranda atau katalog Berkah Koper."
  noindex
>
  <section class="bg-[#0d0d0d] pt-0 pb-20" aria-labelledby="notfound-heading">
    <div class="container-page">
      <div class="gold-line"></div>
      <p class="mt-4 text-sm font-bold uppercase tracking-widest text-[#c9a448]">404</p>
      <h1 id="notfound-heading" class="mt-2 text-3xl text-white md:text-4xl">Halaman tidak ditemukan</h1>
      <p class="mt-3 max-w-xl text-sm leading-7 text-white/55 md:text-base">
        Alamat ini tidak ada. Cek tautan, atau lanjut ke katalog produk.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/" class="btn-outline-gold">Beranda</a>
        <a href="/katalog" class="btn-primary">Katalog Produk</a>
      </div>
    </div>
  </section>
</Layout>
