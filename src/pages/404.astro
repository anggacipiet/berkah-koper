---
import Layout from '../layouts/Layout.astro';

export const prerender = true;

Astro.response.status = 404;
---

<Layout
  title="Halaman tidak ditemukan"
  description="Halaman yang Anda cari tidak ada. Kembali ke beranda atau katalog Berkah Koper."
  noindex
>
  <section class="bg-white py-16 md:py-20" aria-labelledby="notfound-heading">
    <div class="container-page">
      <div class="inline-flex items-center gap-3 text-[0.68rem] font-bold uppercase tracking-[0.2em] text-[#c9a448]">
        <span class="h-px w-7 bg-[#c9a448]" aria-hidden="true"></span>
        404
      </div>
      <h1 id="notfound-heading" class="mt-3 font-display text-3xl font-semibold text-[#161412] md:text-4xl">Halaman tidak ditemukan</h1>
      <p class="mt-3 max-w-xl text-sm leading-7 text-[#5c5854] md:text-base">
        Alamat ini tidak ada. Cek tautan, atau lanjut ke katalog produk.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/" class="inline-flex items-center justify-center gap-1.5 rounded-full border border-[#c9a448] bg-transparent px-5 py-3 text-sm font-semibold text-[#161412] no-underline transition hover:bg-[#c9a448] hover:text-[#111]">Beranda</a>
        <a href="/katalog" class="btn-primary">Katalog Produk</a>
      </div>
    </div>
  </section>
</Layout>
