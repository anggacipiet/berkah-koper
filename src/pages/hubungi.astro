---
import Layout from '../layouts/Layout.astro';
import { getSiteWa } from '../data/hero';

export const prerender = true;

const siteWa = getSiteWa();
const waDigits = siteWa.number;
const waDisplay = siteWa.display;
---

<Layout
  title="Hubungi Kami"
  description="Hubungi Berkah Koper via WhatsApp. Supplier koper & tas Haji Umrah, Kalideres Jakarta Barat."
  canonicalPath="/hubungi/"
>
  <div class="bg-white">
    <header class="border-b border-[#e8e8e8] bg-white py-7 lg:py-9">
      <div class="container-page">
        <div class="inline-flex items-center gap-3 text-[0.68rem] font-bold uppercase tracking-[0.2em] text-[#c9a448]"><span class="h-px w-7 bg-[#c9a448]" aria-hidden="true"></span>Kontak</div>
        <h1 id="hubungi-heading" class="mt-[0.55rem] font-display text-[clamp(2.35rem,4.5vw,3.25rem)] font-semibold leading-[1.05] tracking-[-0.02em] text-[#161412]">Hubungi Kami</h1>
        <p class="mt-3 max-w-xl text-[0.95rem] leading-[1.7] text-[#5c5854]">
          Ada pertanyaan atau ingin konsultasi? Isi formulir singkat di bawah — kami lanjutkan lewat WhatsApp.
        </p>
      </div>
    </header>

    <section class="bg-white py-9 md:py-11" aria-labelledby="hubungi-heading">
      <div class="container-page grid items-start gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
        <form id="hubungi-wa-form" class="grid gap-[1.15rem]" novalidate>
          <div>
            <label for="wa-phone" class="mb-2 block text-[0.72rem] font-bold uppercase tracking-[0.12em] text-[#7a756f]">Nomor WhatsApp</label>
            <input
              id="wa-phone"
              name="phone"
              type="tel"
              inputmode="tel"
              autocomplete="tel"
              required
              placeholder="08xxxx..."
              class="w-full rounded-none border border-[#e8e8e8] bg-white px-[1.05rem] py-[0.95rem] text-[0.92rem] leading-[1.4] text-[#161412] outline-none transition placeholder:text-[#9a9a9a] focus:border-[#c9a448] focus:shadow-[0_0_0_3px_rgba(201,164,72,0.12)]"
            />
          </div>
          <div>
            <label for="wa-name" class="mb-2 block text-[0.72rem] font-bold uppercase tracking-[0.12em] text-[#7a756f]">Nama</label>
            <input id="wa-name" name="name" type="text" autocomplete="name" required placeholder="Nama lengkap Anda" class="w-full rounded-none border border-[#e8e8e8] bg-white px-[1.05rem] py-[0.95rem] text-[0.92rem] leading-[1.4] text-[#161412] outline-none transition placeholder:text-[#9a9a9a] focus:border-[#c9a448] focus:shadow-[0_0_0_3px_rgba(201,164,72,0.12)]" />
          </div>
          <div>
            <label for="wa-company" class="mb-2 block text-[0.72rem] font-bold uppercase tracking-[0.12em] text-[#7a756f]">Perusahaan</label>
            <input id="wa-company" name="company" type="text" autocomplete="organization" placeholder="Opsional" class="w-full rounded-none border border-[#e8e8e8] bg-white px-[1.05rem] py-[0.95rem] text-[0.92rem] leading-[1.4] text-[#161412] outline-none transition placeholder:text-[#9a9a9a] focus:border-[#c9a448] focus:shadow-[0_0_0_3px_rgba(201,164,72,0.12)]" />
          </div>
          <div>
            <label for="wa-message" class="mb-2 block text-[0.72rem] font-bold uppercase tracking-[0.12em] text-[#7a756f]">Pesan</label>
            <textarea id="wa-message" name="message" rows="5" required placeholder="Tulis kebutuhan atau pertanyaan Anda" class="w-full resize-y rounded-none border border-[#e8e8e8] bg-white px-[1.05rem] py-[0.95rem] text-[0.92rem] leading-[1.4] text-[#161412] outline-none transition placeholder:text-[#9a9a9a] focus:border-[#c9a448] focus:shadow-[0_0_0_3px_rgba(201,164,72,0.12)]"></textarea>
          </div>
          <button type="submit" class="btn-primary inline-flex w-full items-center justify-center gap-2 sm:w-auto">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4" aria-hidden="true">
              <path d="M3.4 20.4 20.85 12.92c.76-.33.76-1.5 0-1.84L3.4 3.6a1 1 0 0 0-1.44 1.12l1.9 6.56a1 1 0 0 0 .76.7l8.1 1.02-8.1 1.02a1 1 0 0 0-.76.7l-1.9 6.56a1 1 0 0 0 1.44 1.12Z" />
            </svg>
            Kirim
          </button>
          <p id="hubungi-form-error" class="hidden text-sm text-red-600" role="alert"></p>
        </form>

        <aside class="relative border border-[#e8e8e8] bg-white px-6 pb-6 pt-7 before:absolute before:inset-x-0 before:top-0 before:h-0.5 before:bg-[#c9a448] before:content-[''] md:px-7 md:pb-7 md:pt-8" aria-label="Kontak Berkah Koper">
          <div class="text-[0.68rem] font-bold uppercase tracking-[0.18em] text-[#c9a448]">Kontak</div>
          <div class="mt-2 border-b border-[#e8e8e8] pb-4 font-display text-[1.55rem] font-semibold leading-[1.2] text-[#161412]">Kontak Kami</div>
          <dl class="mt-1">
            <div class="border-b border-[#e8e8e8] py-[0.95rem] last:border-b-0 last:pb-0">
              <dt class="text-[0.68rem] font-bold uppercase tracking-[0.16em] text-[#7a756f]">Lokasi</dt>
              <dd class="mt-1.5 text-[0.92rem] leading-[1.6] text-[#5c5854]">Kalideres, Jakarta Barat, DKI Jakarta, Indonesia</dd>
            </div>
            <div class="border-b border-[#e8e8e8] py-[0.95rem] last:border-b-0 last:pb-0">
              <dt class="text-[0.68rem] font-bold uppercase tracking-[0.16em] text-[#7a756f]">Jam Kerja</dt>
              <dd class="mt-1.5 text-[0.92rem] leading-[1.6] text-[#5c5854]">Senin–Sabtu, 08.00–20.00 WIB</dd>
            </div>
            <div class="border-b border-[#e8e8e8] py-[0.95rem] last:border-b-0 last:pb-0">
              <dt class="text-[0.68rem] font-bold uppercase tracking-[0.16em] text-[#7a756f]">Kontak</dt>
              <dd class="mt-1.5 text-[0.92rem] leading-[1.6] text-[#5c5854]">
                <a href={`tel:+${String(waDigits).replace(/\D/g, '')}`} class="text-[#5c5854] no-underline transition-colors hover:text-[#c9a448]">{waDisplay}</a>
              </dd>
            </div>
            <div class="border-b border-[#e8e8e8] py-[0.95rem] last:border-b-0 last:pb-0">
              <dt class="text-[0.68rem] font-bold uppercase tracking-[0.16em] text-[#7a756f]">Follow Kami</dt>
              <dd class="mt-1.5 text-[0.92rem] leading-[1.6] text-[#5c5854]">
                <div class="mt-0.5 flex flex-wrap gap-3" aria-label="Media sosial">
                  <a
                    href={`https://wa.me/${waDigits}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Chat WhatsApp"
                    class="grid size-12 place-items-center rounded-full border border-[#e8e8e8] bg-white text-[#161412] transition hover:border-[#25d366]/50 hover:bg-[#25d366]/10 hover:text-[#25d366]"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                  </a>
                  <a
                    href="https://instagram.com/berkahkoper"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Instagram"
                    class="grid size-12 place-items-center rounded-full border border-[#e8e8e8] bg-white text-[#161412] transition hover:border-[#e1306c]/50 hover:bg-[#e1306c]/10 hover:text-[#e1306c]"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                  </a>
                  <a
                    href="https://tiktok.com/@berkahkoper"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="TikTok"
                    class="grid size-12 place-items-center rounded-full border border-[#e8e8e8] bg-white text-[#161412] transition hover:border-[#161412]/30 hover:bg-[#161412]/5"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.76a4.85 4.85 0 0 1-1.01-.07z"/></svg>
                  </a>
                  <a
                    href="https://facebook.com/berkahkoper"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Facebook"
                    class="grid size-12 place-items-center rounded-full border border-[#e8e8e8] bg-white text-[#161412] transition hover:border-[#1877f2]/50 hover:bg-[#1877f2]/10 hover:text-[#1877f2]"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                  </a>
                </div>
              </dd>
            </div>
          </dl>
        </aside>
      </div>
    </section>
  </div>
</Layout>

<script define:vars={{ waDigits }}>
  const form = document.getElementById('hubungi-wa-form');
  const err = document.getElementById('hubungi-form-error');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (err) {
      err.classList.add('hidden');
      err.textContent = '';
    }

    const fd = new FormData(form);
    const phone = String(fd.get('phone') || '').trim();
    const name = String(fd.get('name') || '').trim();
    const company = String(fd.get('company') || '').trim();
    const message = String(fd.get('message') || '').trim();

    if (!phone || !name || !message) {
      if (err) {
        err.textContent = 'Nomor WhatsApp, nama, dan pesan wajib diisi.';
        err.classList.remove('hidden');
      }
      return;
    }

    const lines = [
      "Assalamu'alaikum Berkah Koper,",
      '',
      `Nama: ${name}`,
      company ? `Perusahaan: ${company}` : null,
      `WhatsApp: ${phone}`,
      '',
      'Pesan:',
      message,
    ].filter(Boolean);

    const url = `https://wa.me/${waDigits}?text=${encodeURIComponent(lines.join('\n'))}`;
    window.open(url, '_blank', 'noopener,noreferrer');
  });
</script>
