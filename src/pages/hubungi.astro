---
import Layout from '../layouts/Layout.astro';
import { getHubungi } from '../data/hubungi';

export const prerender = true;

const hubungi = getHubungi();
---

<Layout
  title="Hubungi Kami — Berkah Koper"
  description={hubungi.description}
>
  <!-- pt-0: gold-line flush di bawah header (efek sama #tentang yg ketutup sticky) -->
  <section class="bg-[#0d0d0d] pt-0 pb-12 md:pb-16" aria-labelledby="hubungi-heading">
    <div class="container-page">
      <div class="gold-line"></div>
      <h1 id="hubungi-heading" class="mt-4 text-3xl text-white md:text-4xl">
        {hubungi.heading}
      </h1>
      <p class="mt-3 max-w-2xl text-sm leading-7 text-white/55 md:text-base">
        {hubungi.description}
      </p>

      <div class="mt-10 space-y-12">
        {hubungi.groups.map((group, gi) => (
          <section aria-labelledby={`hubungi-group-${gi}`}>
            <div class="grid items-start gap-6 lg:grid-cols-[0.9fr_1.1fr] lg:gap-10">
              <!-- Foto grup / branding Berkah Koper -->
              <figure class="overflow-hidden rounded-2xl border border-white/8 bg-[#161616]">
                <img
                  src={group.coverImage}
                  alt={group.title}
                  class="aspect-[4/3] w-full object-cover"
                  loading="lazy"
                  decoding="async"
                  width="640"
                  height="480"
                />
              </figure>

              <div>
                <h2 id={`hubungi-group-${gi}`} class="text-2xl text-white md:text-3xl">
                  {group.title}
                </h2>
                {group.description && (
                  <p class="mt-2 text-sm leading-6 text-white/50">{group.description}</p>
                )}

                {group.admins.length === 0 ? (
                  <p class="mt-6 text-sm text-white/40">Belum ada admin di grup ini.</p>
                ) : (
                  <ul class="mt-6 grid gap-4 sm:grid-cols-2">
                    {group.admins.map((admin) => (
                      <li class="rounded-2xl border border-white/8 bg-[#161616] p-4 transition-colors hover:border-[#c9a448]/30">
                        <div class="flex items-center gap-3">
                          <img
                            src={admin.image}
                            alt={admin.name}
                            class="size-14 shrink-0 rounded-full object-cover ring-1 ring-[#c9a448]/25"
                            loading="lazy"
                            decoding="async"
                            width="56"
                            height="56"
                          />
                          <div class="min-w-0">
                            <div class="truncate font-body text-sm font-bold text-white">
                              {admin.name}
                            </div>
                            <div class="text-xs text-[#c9a448]/80">{admin.role}</div>
                            <div class="mt-0.5 text-xs text-white/45">{admin.phoneDisplay}</div>
                          </div>
                        </div>
                        <a
                          href={admin.waUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="btn-wa mt-4 inline-flex w-full justify-center"
                        >
                          Chat WhatsApp
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>
</Layout>
