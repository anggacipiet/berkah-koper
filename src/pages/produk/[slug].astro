---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import ColorPicker from '../../components/ColorPicker.astro';
import {
  getAllProducts,
  getProductBySlug,
  buildWaUrl,
  getProductsByCategory,
} from '../../data/products';
import { CATEGORY_LABELS } from '../../types/product';
import { parseProductDescription } from '../../lib/format-description';
import { responsiveImage } from '../../lib/media';
import type { GetStaticPaths } from 'astro';

export const prerender = true;

export const getStaticPaths: GetStaticPaths = () =>
  getAllProducts().map((p) => ({ params: { slug: p.slug } }));

const { slug } = Astro.params;
const product = getProductBySlug(String(slug ?? ''));
if (!product) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

const {
  name, category, description, images,
  badge, colorGroups, features, weight, material,
  sizes, inStock, isBundle, bundleItems, priceLabel,
} = product;

const gallery = images.map((src) => ({
  full: src,
  ...responsiveImage(src, '(max-width: 1024px) 100vw, 560px'),
}));

const waBase = buildWaUrl(product);
const catLabel = CATEGORY_LABELS[category] ?? category;

const related = getProductsByCategory(category)
  .filter((p) => p.slug !== slug)
  .filter((p) => (isBundle ? p.isBundle : !p.isBundle))
  .slice(0, 4);

const askPriceLabel = priceLabel?.trim() || 'Tanya Harga';
const descBlocks = parseProductDescription(description);

const imageAltMap: string[] = [
  `${name} — tampilan depan`,
  `${name} — tampilan sudut`,
  `${name} — detail warna`,
  `${name} — tampilan samping`,
  `${name} — pilihan warna lain`,
  `${name} — interior & kompartemen`,
];
---

<Layout
  title={`${name} — Berkah Koper`}
  description="Detail produk Berkah Koper — koper & perlengkapan Haji Umrah harga pabrik."
  canonicalPath={`/produk/${product.slug}/`}
>
  <div class="min-h-screen bg-white py-8">
    <div class="container-page">
      <nav class="mb-6 flex flex-wrap items-center gap-1.5 text-xs text-[#7a756f]" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-[#c9a448]">Beranda</a>
        <span aria-hidden="true">/</span>
        <a href="/katalog" class="transition-colors hover:text-[#c9a448]">Katalog</a>
        <span aria-hidden="true">/</span>
        <a href={`/katalog?kategori=${category}`} class="transition-colors hover:text-[#c9a448]">{catLabel}</a>
        <span aria-hidden="true">/</span>
        <span class="line-clamp-1 text-[#161412]">{name}</span>
      </nav>

      <div class="overflow-hidden border border-[#e8e8e8] bg-white">
        <div class="grid lg:grid-cols-[1fr_1fr]">
          <div class="relative bg-white p-5 md:p-6">
            {badge && (
              <div class="absolute left-8 top-8 z-10">
                <span class="badge">{badge}</span>
              </div>
            )}
            <div class="img-zoom aspect-square cursor-zoom-in overflow-hidden border border-[#e8e8e8] bg-white" id="main-img-wrap">
              {gallery[0] ? (
                <img
                  id="main-img"
                  src={gallery[0].src}
                  srcset={gallery[0].srcset}
                  sizes={gallery[0].sizes}
                  data-full={gallery[0].full}
                  alt={imageAltMap[0]}
                  class="h-full w-full object-cover"
                  width="600"
                  height="600"
                />
              ) : (
                <div class="flex h-full items-center justify-center text-7xl" aria-hidden="true">🧳</div>
              )}
            </div>
            {gallery.length > 1 && (
              <div class="mt-3 flex gap-2 overflow-x-auto pb-1" role="list" aria-label={`Galeri foto ${name}`}>
                {gallery.map((g, i) => {
                  const alt = imageAltMap[i] ?? `${name} — foto ${i + 1}`;
                  return (
                    <button
                      role="listitem"
                      class="thumb-btn shrink-0 overflow-hidden border-2 border-[#e8e8e8] transition-all hover:border-[#c9a448] focus:border-[#c9a448] focus:outline-none"
                      data-src={g.src}
                      data-srcset={g.srcset ?? ''}
                      data-full={g.full}
                      aria-label={`Lihat: ${alt}`}
                    >
                      <img src={g.src} alt={alt} class="size-16 object-cover" loading="lazy" decoding="async" width="64" height="64" />
                    </button>
                  );
                })}
              </div>
            )}
          </div>

          <div class="flex flex-col gap-5 border-t border-[#e8e8e8] p-6 lg:border-l lg:border-t-0 lg:p-8">
            <div>
              <div class="text-[10px] font-bold uppercase tracking-[.18em] text-[#c9a448]">{catLabel}</div>
              <h1 class="mt-1.5 font-display text-3xl leading-snug text-[#161412] lg:text-4xl">{name}</h1>
            </div>

            <div class="border border-[#c9a448]/35 bg-white p-4">
              <div class="text-sm font-semibold text-[#c9a448]">{askPriceLabel}</div>
              <div class="mt-1 text-sm text-[#5c5854]">Hubungi kami via WhatsApp untuk info harga terkini dan ketersediaan stok.</div>
              {!inStock && (
                <div class="mt-2 inline-block border border-red-300 px-3 py-1 text-xs font-bold text-red-600">Stok Habis</div>
              )}
            </div>

            <div class="space-y-2 text-[#5c5854]">
              {descBlocks.map((block) =>
                block.type === 'p' ? (
                  <p class="leading-7">{block.text}</p>
                ) : (
                  <div
                    class="flex gap-2 leading-7"
                    style={
                      block.marker === 'star'
                        ? undefined
                        : `margin-left: ${Math.max(block.depth, 1) * 1.1}rem`
                    }
                  >
                    <span
                      class:list={[
                        'shrink-0 select-none text-[#c9a448]',
                        block.marker === 'star' ? 'w-[0.75rem] text-left' : 'w-4 text-left',
                      ]}
                      aria-hidden="true"
                    >
                      {block.marker === 'star' ? '*' : '•'}
                    </span>
                    <span class="min-w-0 flex-1">{block.text}</span>
                  </div>
                ),
              )}
            </div>

            {sizes && sizes.length > 0 && (
              <div>
                <div class="mb-2 text-sm font-bold text-[#161412]">
                  Pilih Ukuran
                  <span id="size-selected-label" class="ml-2 text-xs font-normal text-[#7a756f]">— belum dipilih</span>
                </div>
                <div class="flex flex-wrap gap-2" role="radiogroup" aria-label="Pilihan ukuran">
                  {sizes.map((sz) => (
                    <button
                      type="button"
                      role="radio"
                      aria-checked="false"
                      data-size={sz}
                      class="size-btn border-2 border-[#e8e8e8] bg-white px-5 py-2.5 text-sm font-bold text-[#161412] transition-all hover:border-[#c9a448] hover:text-[#c9a448] aria-checked:border-[#c9a448] aria-checked:text-[#c9a448]"
                    >
                      {sz}
                    </button>
                  ))}
                </div>
              </div>
            )}

            {colorGroups && colorGroups.length > 0 && (
              <div>
                <div class="mb-3 flex items-center gap-2">
                  <div class="text-sm font-bold text-[#161412]">Pilih Warna</div>
                  <span class="rounded-full bg-[#c9a448]/15 px-2.5 py-0.5 text-xs font-semibold text-[#c9a448]">
                    {colorGroups.reduce((s, g) => s + g.colors.length, 0)} pilihan
                  </span>
                </div>
                <ColorPicker colorGroups={colorGroups} productName={name} light />
              </div>
            )}

            {isBundle && bundleItems && bundleItems.length > 0 && (
              <div>
                <div class="mb-2 text-sm font-bold text-[#161412]">Isi Paket</div>
                <ul class="space-y-1.5">
                  {bundleItems.map((item) => (
                    <li class="flex items-center gap-2 text-sm text-[#5c5854]">
                      <span class="text-[#c9a448]" aria-hidden="true">✓</span>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {features && features.length > 0 && (
              <div>
                <div class="mb-2 text-sm font-bold text-[#161412]">Keunggulan Produk</div>
                <ul class="grid gap-1.5 sm:grid-cols-2">
                  {features.map((f) => (
                    <li class="flex items-start gap-2 text-sm text-[#5c5854]">
                      <span class="text-[#c9a448]" aria-hidden="true">—</span>
                      {f}
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {(weight || material || sizes) && (
              <div class="border border-[#e8e8e8] bg-white p-4">
                <div class="mb-2 text-[10px] font-bold uppercase tracking-[.16em] text-[#c9a448]">Spesifikasi</div>
                <dl class="grid grid-cols-2 gap-x-4 gap-y-1.5 text-sm">
                  {weight && (
                    <>
                      <dt class="font-semibold text-[#7a756f]">Berat</dt>
                      <dd class="text-[#5c5854]">{weight}</dd>
                    </>
                  )}
                  {material && (
                    <>
                      <dt class="font-semibold text-[#7a756f]">Material</dt>
                      <dd class="text-[#5c5854]">{material}</dd>
                    </>
                  )}
                  {sizes && (
                    <>
                      <dt class="font-semibold text-[#7a756f]">Ukuran</dt>
                      <dd class="text-[#5c5854]">{sizes.join(', ')}</dd>
                    </>
                  )}
                </dl>
              </div>
            )}

            <div class="mt-auto flex flex-col gap-3 border-t border-[#e8e8e8] pt-4 sm:flex-row">
              {inStock ? (
                <a
                  id="wa-btn"
                  href={waBase}
                  data-wa-base={waBase}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-primary flex-1 justify-center"
                  aria-label={`Beli ${name} via WhatsApp`}
                >
                  Beli via WhatsApp
                </a>
              ) : (
                <button disabled class="btn-primary flex-1 cursor-not-allowed opacity-40">Stok Habis</button>
              )}
              <a href="/katalog" class="inline-flex flex-1 items-center justify-center gap-1.5 rounded-full border border-[#c9a448] bg-transparent px-5 py-3 text-sm font-semibold text-[#161412] no-underline transition hover:bg-[#c9a448] hover:text-[#111]">← Katalog</a>
            </div>
          </div>
        </div>
      </div>

      {related.length > 0 && (
        <section class="mt-16" aria-labelledby="related-heading" data-nosnippet>
          <div class="inline-flex items-center gap-3 text-[0.68rem] font-bold uppercase tracking-[0.2em] text-[#c9a448]"><span class="h-px w-7 bg-[#c9a448]" aria-hidden="true"></span>Serupa</div>
          <h2 id="related-heading" class="mt-3 text-2xl text-[#161412] md:text-3xl">Produk Serupa</h2>
          <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {related.map((p) => <ProductCard product={p} />)}
          </div>
        </section>
      )}
    </div>
  </div>

  <div
    id="lightbox"
    class="fixed inset-0 z-[200] hidden items-center justify-center bg-black/90 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-label="Zoom gambar produk"
  >
    <button
      id="lightbox-close"
      class="absolute right-4 top-4 flex size-10 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-[#c9a448] hover:text-black"
      aria-label="Tutup"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
    <div class="flex max-h-[90vh] max-w-[90vw] items-center justify-center p-4">
      <img id="lightbox-img" src="" alt="" class="max-h-[85vh] max-w-[85vw] rounded-xl object-contain shadow-2xl" />
    </div>
  </div>
</Layout>

<script>
  const mainImg = document.getElementById('main-img') as HTMLImageElement | null;
  const mainWrap = document.getElementById('main-img-wrap');
  const thumbBtns = document.querySelectorAll<HTMLButtonElement>('.thumb-btn');

  thumbBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const src = btn.dataset.src;
      if (mainImg && src) {
        mainImg.src = src;
        mainImg.srcset = btn.dataset.srcset ?? '';
        mainImg.dataset.full = btn.dataset.full ?? src;
        thumbBtns.forEach((b) => b.classList.remove('border-[#c9a448]'));
        btn.classList.add('border-[#c9a448]');
      }
    });
  });

  const lightbox = document.getElementById('lightbox') as HTMLElement;
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxClose = document.getElementById('lightbox-close');

  function openLightbox(src: string, alt: string) {
    lightboxImg.src = src;
    lightboxImg.alt = alt;
    lightbox.classList.remove('hidden');
    lightbox.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lightbox.classList.add('hidden');
    lightbox.classList.remove('flex');
    document.body.style.overflow = '';
  }

  mainWrap?.addEventListener('click', () => {
    if (!mainImg) return;
    const full = mainImg.dataset.full || mainImg.currentSrc || mainImg.src;
    if (full) openLightbox(full, mainImg.alt);
  });

  lightboxClose?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });

  const sizeBtns = document.querySelectorAll<HTMLButtonElement>('.size-btn');
  const sizeLabel = document.getElementById('size-selected-label');
  const waBtn = document.getElementById('wa-btn') as HTMLAnchorElement | null;

  sizeBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      sizeBtns.forEach((b) => b.setAttribute('aria-checked', 'false'));
      btn.setAttribute('aria-checked', 'true');
      const size = btn.dataset.size ?? '';
      if (sizeLabel) sizeLabel.textContent = size;
      if (waBtn) {
        const base = waBtn.dataset.waBase ?? waBtn.getAttribute('href') ?? '';
        const cleaned = base.replace(/%0A%0AUkuran[^&]*/g, '');
        const updated = cleaned + encodeURIComponent(`\n\nUkuran: ${size}`);
        waBtn.href = updated;
        waBtn.dataset.waBase = updated;
      }
    });
  });
</script>
