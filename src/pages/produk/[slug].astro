---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import ColorPicker from '../../components/ColorPicker.astro';
import {
  getAllProducts,
  getProductBySlug,
  buildWaMessage,
  getProductsByCategory,
} from '../../data/products';
import { CATEGORY_LABELS } from '../../types/product';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () =>
  getAllProducts().map((p) => ({ params: { slug: p.slug } }));

const { slug } = Astro.params;
const product  = getProductBySlug(String(slug ?? ''));
if (!product) return Astro.redirect('/katalog');

const {
  name, category, description, images,
  badge, variants, colorGroups, features, weight, material,
  sizes, inStock, isBundle, bundleItems,
} = product;

const WA_NUMBER = '6285282400061';
const waBase    = `https://wa.me/${WA_NUMBER}?text=${buildWaMessage(product)}`;
const catLabel  = CATEGORY_LABELS[category] ?? category;

const related = getProductsByCategory(category)
  .filter((p) => p.slug !== slug)
  .slice(0, 4);

const pageTitle = `${name} — Berkah Koper`;
const pageDesc  = product.shortDesc;
const pageImage = images[0];

const badgeClass =
  badge === 'TERLARIS' ? 'badge-gold'
  : badge === 'BARU'   ? 'badge-green'
  :                      'badge-red';

const imageAltMap: string[] = [
  `${name} — tampilan depan`,
  `${name} — tampilan sudut`,
  `${name} — detail warna`,
  `${name} — tampilan samping`,
  `${name} — pilihan warna lain`,
  `${name} — interior & kompartemen`,
];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name,
  description,
  image: images,
  brand: { '@type': 'Brand', name: 'Berkah Koper' },
  offers: {
    '@type': 'Offer',
    priceCurrency: 'IDR',
    availability: inStock
      ? 'https://schema.org/InStock'
      : 'https://schema.org/OutOfStock',
    seller: { '@type': 'Organization', name: 'Berkah Koper' },
  },
});
---

<Layout title={pageTitle} description={pageDesc} image={pageImage} type="product">
  <script type="application/ld+json" set:html={jsonLd} />

  <div class="min-h-screen bg-[#0d0d0d] py-8">
    <div class="container-page">

      <!-- Breadcrumb -->
      <nav class="mb-6 flex flex-wrap items-center gap-1.5 text-xs text-white/30" aria-label="Breadcrumb">
        <a href="/"         class="hover:text-[#c9a448] transition-colors">Beranda</a>
        <span aria-hidden="true">/</span>
        <a href="/katalog"  class="hover:text-[#c9a448] transition-colors">Katalog</a>
        <span aria-hidden="true">/</span>
        <a href={`/katalog?kategori=${category}`} class="hover:text-[#c9a448] transition-colors">{catLabel}</a>
        <span aria-hidden="true">/</span>
        <span class="line-clamp-1 text-white/60">{name}</span>
      </nav>

      <!-- ── CARD DETAIL ─────────────────────────────────────── -->
      <div class="overflow-hidden rounded-3xl border border-white/10 bg-[#111111] shadow-xl">
        <div class="grid lg:grid-cols-[1fr_1fr]">

          <!-- ── Galeri ─────────────────────────────────────── -->
          <div class="relative bg-[#1a1a1a] p-6">
            {badge && (
              <div class="absolute left-8 top-8 z-10">
                <span class={`badge ${badgeClass}`}>{badge}</span>
              </div>
            )}

            <!-- Gambar utama — klik untuk zoom -->
            <div class="img-zoom aspect-square cursor-zoom-in overflow-hidden rounded-2xl bg-[#222222]" id="main-img-wrap">
              {images[0] ? (
                <img
                  id="main-img"
                  src={images[0]}
                  alt={imageAltMap[0]}
                  class="h-full w-full object-cover"
                  width="600"
                  height="600"
                />
              ) : (
                <div class="flex h-full items-center justify-center text-7xl" aria-hidden="true">🧳</div>
              )}
            </div>

            <!-- Thumbnails -->
            {images.length > 1 && (
              <div class="mt-3 flex gap-2 overflow-x-auto pb-1" role="list" aria-label={`Galeri foto ${name}`}>
                {images.map((src, i) => {
                  const alt = imageAltMap[i] ?? `${name} — foto ${i + 1}`;
                  return (
                    <button
                      role="listitem"
                      class="thumb-btn shrink-0 overflow-hidden rounded-xl border-2 border-white/10 transition-all hover:border-[#c9a448] focus:border-[#c9a448] focus:outline-none"
                      data-src={src}
                      aria-label={`Lihat: ${alt}`}
                    >
                      <img src={src} alt={alt} class="size-16 object-cover" loading="lazy" decoding="async" width="64" height="64" />
                    </button>
                  );
                })}
              </div>
            )}
          </div>

          <!-- ── Info produk ────────────────────────────────── -->
          <div class="flex flex-col gap-5 p-6 lg:p-8">

            <!-- Kategori + nama -->
            <div>
              <div class="text-xs font-bold uppercase tracking-widest text-[#c9a448]">{catLabel}</div>
              <h1 class="mt-1.5 text-2xl font-black leading-snug text-white lg:text-3xl">{name}</h1>
            </div>

            <!-- Harga — hubungi WA untuk info harga -->
            <div class="rounded-2xl bg-[#c9a448]/8 border border-[#c9a448]/20 p-4">
              <div class="text-sm font-semibold text-[#c9a448]">Harga & Pemesanan</div>
              <div class="mt-1 text-base text-white/70">Hubungi kami via WhatsApp untuk info harga terkini dan ketersediaan stok.</div>
              {!inStock && (
                <div class="mt-2 inline-block rounded-full bg-red-500/20 px-3 py-1 text-xs font-bold text-red-400">
                  Stok Habis
                </div>
              )}
            </div>

            <!-- Deskripsi -->
            <p class="leading-7 text-white/70">{description}</p>

            <!-- Pilih ukuran -->
            {sizes && sizes.length > 0 && (
              <div>
                <div class="mb-2 text-sm font-bold text-white">
                  Pilih Ukuran
                  <span id="size-selected-label" class="ml-2 text-xs font-normal text-white/40">— belum dipilih</span>
                </div>
                <div class="flex flex-wrap gap-2" role="radiogroup" aria-label="Pilihan ukuran">
                  {sizes.map((sz) => (
                    <button
                      type="button"
                      role="radio"
                      aria-checked="false"
                      data-size={sz}
                      class="size-btn rounded-xl border-2 border-white/15 bg-white/5 px-5 py-2.5 text-sm font-bold text-white/80 transition-all hover:border-[#c9a448] hover:text-[#c9a448] aria-checked:border-[#c9a448] aria-checked:bg-[#c9a448]/10 aria-checked:text-[#c9a448]"
                    >
                      {sz}
                    </button>
                  ))}
                </div>
              </div>
            )}

            <!-- Color picker -->
            {colorGroups && colorGroups.length > 0 && (
              <div>
                <div class="mb-3 flex items-center gap-2">
                  <div class="text-sm font-bold text-white">Pilih Warna</div>
                  <span class="rounded-full bg-[#c9a448]/15 px-2.5 py-0.5 text-xs font-semibold text-[#c9a448]">
                    {colorGroups.reduce((s, g) => s + g.colors.length, 0)} pilihan
                  </span>
                </div>
                <ColorPicker colorGroups={colorGroups} productName={name} />
              </div>
            )}

            <!-- Isi bundling -->
            {isBundle && bundleItems && bundleItems.length > 0 && (
              <div>
                <div class="mb-2 text-sm font-bold text-white">Isi Paket</div>
                <ul class="space-y-1.5">
                  {bundleItems.map((item) => (
                    <li class="flex items-center gap-2 text-sm text-white/70">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 shrink-0 text-[#c9a448]" aria-hidden="true">
                        <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                      </svg>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <!-- Fitur -->
            {features && features.length > 0 && (
              <div>
                <div class="mb-2 text-sm font-bold text-white">Keunggulan Produk</div>
                <ul class="grid gap-1.5 sm:grid-cols-2">
                  {features.map((f) => (
                    <li class="flex items-start gap-2 text-sm text-white/70">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 size-4 shrink-0 text-[#c9a448]" aria-hidden="true">
                        <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                      </svg>
                      {f}
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <!-- Spesifikasi -->
            {(weight || material || sizes) && (
              <div class="rounded-xl border border-white/10 bg-white/3 p-4">
                <div class="mb-2 text-xs font-bold uppercase tracking-wider text-white/40">Spesifikasi</div>
                <dl class="grid grid-cols-2 gap-x-4 gap-y-1.5 text-sm">
                  {weight && (
                    <>
                      <dt class="font-semibold text-white/60">Berat</dt>
                      <dd class="text-white/50">{weight}</dd>
                    </>
                  )}
                  {material && (
                    <>
                      <dt class="font-semibold text-white/60">Material</dt>
                      <dd class="text-white/50">{material}</dd>
                    </>
                  )}
                  {sizes && (
                    <>
                      <dt class="font-semibold text-white/60">Ukuran</dt>
                      <dd class="text-white/50">{sizes.join(', ')}</dd>
                    </>
                  )}
                </dl>
              </div>
            )}

            <!-- CTA -->
            <div class="mt-auto flex flex-col gap-3 border-t border-white/10 pt-4 sm:flex-row">
              {inStock ? (
                <a
                  id="wa-btn"
                  href={waBase}
                  data-wa-base={waBase}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-wa flex-1 justify-center"
                  aria-label={`Beli ${name} via WhatsApp`}
                >
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5" aria-hidden="true">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                  </svg>
                  Beli via WhatsApp
                </a>
              ) : (
                <button disabled class="btn-primary flex-1 cursor-not-allowed opacity-40">Stok Habis</button>
              )}
              <a href="/katalog" class="btn-outline-gold flex-1 justify-center">← Katalog</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Produk serupa -->
      {related.length > 0 && (
        <section class="mt-16" aria-labelledby="related-heading">
          <div class="gold-line"></div>
          <h2 id="related-heading" class="mt-4 text-2xl font-black text-white">Produk Serupa</h2>
          <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {related.map((p) => <ProductCard product={p} />)}
          </div>
        </section>
      )}

    </div>
  </div>
<!-- ── Lightbox ──────────────────────────────────────────────── -->
<div
  id="lightbox"
  class="fixed inset-0 z-[200] hidden items-center justify-center bg-black/92 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-label="Zoom gambar produk"
>
  <!-- Tombol tutup -->
  <button
    id="lightbox-close"
    class="absolute right-4 top-4 flex size-10 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-[#c9a448] hover:text-black"
    aria-label="Tutup"
  >
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
    </svg>
  </button>

  <!-- Gambar zoom -->
  <div class="flex max-h-[90vh] max-w-[90vw] items-center justify-center p-4">
    <img
      id="lightbox-img"
      src=""
      alt=""
      class="max-h-[85vh] max-w-[85vw] rounded-xl object-contain shadow-2xl"
    />
  </div>

  <!-- Hint -->
  <div class="absolute bottom-4 left-1/2 -translate-x-1/2 text-xs text-white/30">
    Klik di luar gambar atau tekan Esc untuk menutup
  </div>
</div>

</Layout>

<script>
  // Thumbnail gallery
  const mainImg   = document.getElementById('main-img') as HTMLImageElement | null;
  const mainWrap  = document.getElementById('main-img-wrap');
  const thumbBtns = document.querySelectorAll<HTMLButtonElement>('.thumb-btn');

  thumbBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const src = btn.dataset.src;
      if (mainImg && src) {
        mainImg.src = src;
        thumbBtns.forEach((b) => b.classList.remove('border-[#c9a448]'));
        btn.classList.add('border-[#c9a448]');
      }
    });
  });

  // ── Lightbox ──────────────────────────────────────────────────
  const lightbox    = document.getElementById('lightbox') as HTMLElement;
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxClose = document.getElementById('lightbox-close');

  function openLightbox(src: string, alt: string) {
    lightboxImg.src = src;
    lightboxImg.alt = alt;
    lightbox.classList.remove('hidden');
    lightbox.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lightbox.classList.add('hidden');
    lightbox.classList.remove('flex');
    document.body.style.overflow = '';
  }

  // Klik gambar utama → buka lightbox
  mainWrap?.addEventListener('click', () => {
    if (mainImg?.src) openLightbox(mainImg.src, mainImg.alt);
  });

  // Klik thumbnail → update gambar utama DAN buka lightbox
  thumbBtns.forEach((btn) => {
    btn.addEventListener('dblclick', () => {
      const src = btn.dataset.src ?? '';
      const alt = btn.querySelector('img')?.alt ?? '';
      if (src) openLightbox(src, alt);
    });
  });

  // Tutup lightbox
  lightboxClose?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });

  // Size selector — update WA message dengan ukuran terpilih
  const sizeBtns = document.querySelectorAll<HTMLButtonElement>('.size-btn');
  const sizeLabel = document.getElementById('size-selected-label');
  const waBtn     = document.getElementById('wa-btn') as HTMLAnchorElement | null;

  sizeBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      sizeBtns.forEach((b) => b.setAttribute('aria-checked', 'false'));
      btn.setAttribute('aria-checked', 'true');

      const size = btn.dataset.size ?? '';
      if (sizeLabel) sizeLabel.textContent = size;

      if (waBtn) {
        const base    = waBtn.dataset.waBase ?? waBtn.getAttribute('href') ?? '';
        const cleaned = base.replace(/%0A%0AUkuran[^&]*/g, '');
        const updated = cleaned + encodeURIComponent(`\n\nUkuran: ${size}`);
        waBtn.href           = updated;
        waBtn.dataset.waBase = updated;
      }
    });
  });
</script>
