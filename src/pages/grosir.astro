---
import Layout from '../layouts/Layout.astro';
import { siteWaLink } from '../data/hero';

export const prerender = true;

const waUrl = siteWaLink(
  "Assalamu'alaikum Berkah Koper, saya ingin tanya harga grosir koper untuk travel/umroh.",
);

const points = [
  {
    title: 'Harga pabrik',
    desc: 'Langsung dari supplier — cocok untuk travel, biro, dan toko perlengkapan umroh.',
  },
  {
    title: 'Minimal order jelas',
    desc: 'Skema grosir mulai dari kuantitas yang fleksibel sesuai kebutuhan kloter Anda.',
  },
  {
    title: 'Custom logo & warna',
    desc: 'Sesuaikan identitas travel: logo, warna body, dan aksesori sesuai brand Anda.',
  },
  {
    title: 'Siap kirim tepat waktu',
    desc: 'Produksi dan packing rapi agar stok kloter siap sebelum keberangkatan.',
  },
];

const flow = [
  'Kirim detail kebutuhan via WhatsApp',
  'Kami konfirmasi stok, harga, dan estimasi',
  'Deal → produksi / packing → pengiriman',
];
---

<Layout
  title="Grosir"
  description="Grosir koper & tas Haji Umrah harga pabrik. Minimal order fleksibel, siap kirim ke seluruh Indonesia."
  canonicalPath="/grosir/"
>
  <div class="min-h-screen bg-white">
    <header class="border-b border-[#e8e8e8] bg-white py-7 lg:py-9">
      <div class="container-page grid items-center gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-20">
        <div>
          <div class="inline-flex items-center gap-3 text-[0.68rem] font-bold uppercase tracking-[0.2em] text-[#c9a448]"><span class="h-px w-7 bg-[#c9a448]" aria-hidden="true"></span>B2B</div>
          <h1 class="mt-[0.55rem] font-display text-[clamp(2.35rem,4.5vw,3.25rem)] font-semibold leading-[1.05] tracking-[-0.02em] text-[#161412]">Grosir</h1>
          <p class="mt-3 max-w-xl text-[0.95rem] leading-[1.7] text-[#5c5854]">
            Stok harga pabrik untuk travel &amp; biro umroh — custom logo, warna, dan packing rapi.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href={waUrl} class="btn-primary" target="_blank" rel="noopener noreferrer">Tanya Harga Grosir</a>
            <a href="/katalog" class="inline-flex items-center justify-center gap-1.5 rounded-full border border-[#c9a448] bg-transparent px-5 py-3 text-sm font-semibold text-[#161412] no-underline transition hover:bg-[#c9a448] hover:text-[#111]">Lihat Katalog</a>
          </div>
        </div>

        <aside class="relative border border-[#e8e8e8] bg-white px-6 pb-6 pt-7 before:absolute before:inset-x-0 before:top-0 before:h-0.5 before:bg-[#c9a448] before:content-[''] md:px-7 md:pb-7 md:pt-8" aria-label="Ringkasan grosir">
          <div class="text-[0.68rem] font-bold uppercase tracking-[0.18em] text-[#c9a448]">Ringkasan</div>
          <div class="mt-2 border-b border-[#e8e8e8] pb-4 font-display text-[1.55rem] font-semibold leading-[1.2] text-[#161412]">Grosir koper umroh</div>
          <ul class="mt-1 list-none p-0">
            <li class="flex items-baseline gap-3.5 border-b border-[#e8e8e8] py-3.5 text-[0.9rem] leading-[1.55] text-[#5c5854] last:border-b-0 last:pb-0"><span class="shrink-0 font-display text-base text-[#c9a448]" aria-hidden="true">01</span>Harga pabrik langsung supplier</li>
            <li class="flex items-baseline gap-3.5 border-b border-[#e8e8e8] py-3.5 text-[0.9rem] leading-[1.55] text-[#5c5854] last:border-b-0 last:pb-0"><span class="shrink-0 font-display text-base text-[#c9a448]" aria-hidden="true">02</span>Minimal order jelas &amp; fleksibel</li>
            <li class="flex items-baseline gap-3.5 border-b border-[#e8e8e8] py-3.5 text-[0.9rem] leading-[1.55] text-[#5c5854] last:border-b-0 last:pb-0"><span class="shrink-0 font-display text-base text-[#c9a448]" aria-hidden="true">03</span>Custom logo &amp; warna travel</li>
            <li class="flex items-baseline gap-3.5 border-b border-[#e8e8e8] py-3.5 text-[0.9rem] leading-[1.55] text-[#5c5854] last:border-b-0 last:pb-0"><span class="shrink-0 font-display text-base text-[#c9a448]" aria-hidden="true">04</span>Packing rapi, kirim tepat waktu</li>
          </ul>
        </aside>
      </div>
    </header>

    <section class="bg-white py-9 md:py-11" aria-labelledby="grosir-benefit-heading">
      <div class="container-page">
        <div>
          <div class="inline-flex items-center gap-3 text-[0.68rem] font-bold uppercase tracking-[0.2em] text-[#c9a448]"><span class="h-px w-7 bg-[#c9a448]" aria-hidden="true"></span>Keunggulan</div>
          <h2 id="grosir-benefit-heading" class="mt-3 font-display text-[clamp(1.85rem,3vw,2.45rem)] font-semibold leading-[1.15] text-[#161412]">Kenapa ambil grosir di sini</h2>
        </div>
        <div class="mt-10 grid border-t border-[#e8e8e8] sm:grid-cols-2">
          {points.map((p, i) => (
            <article class="border-b border-[#e8e8e8] pb-[1.65rem] pt-6 sm:border-r sm:px-6 sm:pb-[1.8rem] sm:pt-[1.7rem] sm:odd:pl-0 sm:even:border-r-0 sm:even:pr-0">
              <div class="font-display text-[1.35rem] leading-none text-[#c9a448]">{String(i + 1).padStart(2, '0')}</div>
              <h3 class="mt-3 font-display text-[1.35rem] font-semibold leading-[1.25] text-[#161412]">{p.title}</h3>
              <p class="mt-2 text-[0.9rem] leading-[1.65] text-[#5c5854]">{p.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-white py-9 md:py-11" aria-labelledby="grosir-flow-heading">
      <div class="container-page grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16 lg:items-start">
        <div>
          <div class="inline-flex items-center gap-3 text-[0.68rem] font-bold uppercase tracking-[0.2em] text-[#c9a448]"><span class="h-px w-7 bg-[#c9a448]" aria-hidden="true"></span>Alur singkat</div>
          <h2 id="grosir-flow-heading" class="mt-3 font-display text-[clamp(1.85rem,3vw,2.45rem)] font-semibold leading-[1.15] text-[#161412]">Cara pesan grosir</h2>
          <p class="mt-3.5 max-w-md text-[0.92rem] leading-[1.7] text-[#5c5854]">
            Ceritakan kebutuhan Anda — jumlah, model, warna, dan deadline. Tim kami bantu rekomendasikan paket terbaik.
          </p>
        </div>
        <div class="grid border-t border-[#e8e8e8] md:grid-cols-3">
          {flow.map((step, i) => (
            <article class="border-b border-[#e8e8e8] py-[1.6rem] md:border-b-0 md:border-r md:px-6 md:py-[1.9rem] md:first:pl-0 md:last:border-r-0 md:last:pr-0">
              <div class="font-display text-[2rem] leading-none text-[#c9a448]">{String(i + 1).padStart(2, '0')}</div>
              <h3 class="mt-3.5 max-w-[16rem] font-display text-[1.2rem] font-semibold leading-[1.35] text-[#161412]">{step}</h3>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="border-y border-[#a07828]/55 bg-[#a07828] py-14 text-white" aria-label="Konsultasi grosir">
      <div class="container-page flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
        <div>
          <div class="text-[10px] font-bold uppercase tracking-[.2em] text-white/90">Grosir</div>
          <h2 class="mt-3 max-w-xl font-display text-3xl text-white md:text-4xl">Siap ambil stok untuk kloter berikutnya?</h2>
        </div>
        <div class="flex shrink-0 flex-wrap gap-3">
          <a href="/kemitraan" class="inline-flex min-h-[2.85rem] items-center justify-center gap-1.5 rounded-full border-[1.5px] border-white/55 bg-white/15 px-6 py-3 text-[0.88rem] font-bold tracking-[0.02em] text-white no-underline backdrop-blur-sm transition hover:border-white hover:bg-white hover:text-[#a07828]">Lihat Kemitraan →</a>
          <a href={waUrl} class="inline-flex min-h-[2.85rem] items-center justify-center gap-1.5 rounded-full border-[1.5px] border-white/55 bg-white/15 px-6 py-3 text-[0.88rem] font-bold tracking-[0.02em] text-white no-underline backdrop-blur-sm transition hover:border-white hover:bg-white hover:text-[#a07828]" target="_blank" rel="noopener noreferrer">Chat WhatsApp</a>
        </div>
      </div>
    </section>
  </div>
</Layout>
