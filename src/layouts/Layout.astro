---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'product';
}

const {
  title = 'Berkah Koper — Supplier Koper & Tas Haji Umrah',
  description = 'Supplier koper dan tas Haji & Umrah berkualitas. ABS, Polycarbonate, Polypropylene anti pecah. Custom warna & logo. Harga pabrik. Kalideres, Jakarta Barat.',
  image = '/og-image.jpg',
  type = 'website',
} = Astro.props;

const SITE = Astro.site ?? new URL('https://berkah-koper.pages.dev');
const canonicalURL = new URL(Astro.url.pathname, SITE);
const ogImage = image.startsWith('http')
  ? image
  : new URL(image, SITE).href;

const orgJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': ['Organization', 'LocalBusiness'],
  name: 'Berkah Koper',
  url: SITE.href.replace(/\/$/, ''),
  logo: new URL('/images/logo.webp', SITE).href,
  image: ogImage,
  description,
  telephone: '+6285282400061',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Kalideres',
    addressRegion: 'DKI Jakarta',
    addressCountry: 'ID',
  },
  areaServed: 'ID',
  sameAs: [
    'https://instagram.com/berkahkoper',
    'https://tiktok.com/@berkahkoper',
    'https://facebook.com/berkahkoper',
  ],
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
    opens: '08:00',
    closes: '20:00',
  },
});

const WA_URL = "https://wa.me/6285282400061?text=Assalamu%27alaikum%20Berkah%20Koper%2C%20saya%20ingin%20tanya%20produk.";

const navLinks = [
  { href: '/',          label: 'Beranda' },
  { href: '/katalog',   label: 'Katalog' },
  { href: '/#bundling', label: 'Bundling' },
  { href: '/#tentang',  label: 'Tentang' },
];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#c9a448" />

    <!-- Favicon -->
    <link rel="icon" type="image/webp" href="/images/logo.webp" />

    <!-- Open Graph -->
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:type"        content={type} />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:site_name"   content="Berkah Koper" />
    <meta property="og:locale"      content="id_ID" />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    <!-- Organization / LocalBusiness -->
    <script type="application/ld+json" set:html={orgJsonLd} />

    <!-- Preconnect fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>

  <body>
    <!-- ── Header ──────────────────────────────────────────────── -->
    <header class="sticky top-0 z-50 border-b border-[#c9a448]/20 bg-[#0d0d0d]/95 backdrop-blur-md">
      <div class="container-page flex h-16 items-center justify-between gap-4">

        <!-- Logo -->
        <a href="/" class="flex shrink-0 items-center gap-2" aria-label="Berkah Koper Beranda">
          <img
            src="/images/logo.webp"
            alt="Berkah Koper"
            class="size-8 rounded-lg object-contain sm:size-10 sm:rounded-xl"
            width="40" height="40"
          />
          <div class="min-w-0 leading-tight">
            <div class="text-sm font-black tracking-tight text-white">Berkah Koper</div>
            <div class="truncate text-[8px] font-bold uppercase tracking-[.12em] text-[#c9a448] sm:text-[9px] sm:tracking-[.18em]">Supplier Perlengkapan Haji & Umrah</div>
          </div>
        </a>

        <!-- Nav desktop -->
        <nav class="hidden items-center gap-6 text-sm font-semibold md:flex" aria-label="Navigasi utama">
          {navLinks.map(({ href, label }) => (
            <a
              href={href}
              data-nav-href={href}
              class="nav-link relative pb-0.5 text-white/70 transition-colors hover:text-[#c9a448]"
              style="border-bottom: 2px solid transparent; transition: color .2s, border-color .2s;"
            >
              {label}
            </a>
          ))}
        </nav>

        <!-- CTA + Mobile menu -->
        <div class="flex items-center gap-2">
        <!-- Mobile hamburger -->
          <button
            id="menu-btn"
            class="flex size-9 items-center justify-center rounded-lg border border-[#c9a448]/30 text-white md:hidden"
            aria-label="Buka menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <svg id="icon-open"  xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
            <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="hidden size-5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
          </button>
        </div>
      </div>

      <!-- Mobile menu -->
      <nav
        id="mobile-menu"
        class="hidden border-t border-[#c9a448]/20 bg-[#0d0d0d] px-5 pb-4 md:hidden"
        aria-label="Navigasi mobile"
      >
        {navLinks.map(({ href, label }) => (
          <a href={href} class="block py-2.5 text-sm font-semibold text-white/70 hover:text-[#c9a448] transition-colors">{label}</a>
        ))}
      </nav>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <!-- ── Footer ──────────────────────────────────────────────── -->
    <footer class="text-white" style="background:#0a0a0a;border-top:1px solid rgba(201,164,72,.18);">
