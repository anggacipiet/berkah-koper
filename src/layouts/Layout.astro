---
import '../styles/global.css';
import { getSiteWa, siteWaLink } from '../data/hero';
import { CATALOG_CATEGORIES } from '../types/product';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'product';
  canonicalPath?: string;
  noindex?: boolean;
}

const {
  title = 'Supplier Perlengkapan Umroh dan Haji',
  description = 'Supplier koper umroh & haji dan pabrik koper Jakarta Barat. Custom logo dan warna travel, bahan PP PC ABS anti pecah. Harga pabrik',
  image = '/og-image.jpg',
  type = 'website',
  canonicalPath,
  noindex = false,
} = Astro.props;

const SITE = Astro.site ?? new URL('https://berkah-koper.com');
const resolvedCanonical = canonicalPath ?? Astro.url.pathname;
const canonicalURL = new URL(resolvedCanonical, SITE);
const ogImage = image.startsWith('http') ? image : new URL(image, SITE).href;
const siteWa = getSiteWa();
const WA_URL = siteWaLink("Assalamu'alaikum Berkah Koper, saya ingin tanya produk.");
const siteOrigin = SITE.href.replace(/\/$/, '');
const orgJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteOrigin}/#website`,
      name: 'Berkah Koper',
      alternateName: ['BerkahKoper', 'berkah-koper.com'],
      url: siteOrigin,
      inLanguage: 'id-ID',
      publisher: { '@id': `${siteOrigin}/#organization` },
    },
    {
      '@type': ['Organization', 'LocalBusiness'],
      '@id': `${siteOrigin}/#organization`,
      name: 'Berkah Koper',
      url: siteOrigin,
      logo: new URL('/images/logo.png', SITE).href,
      image: ogImage,
      description,
      telephone: `+${siteWa.number.replace(/\D/g, '')}`,
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Kalideres, Jakarta Barat',
        addressLocality: 'Kalideres',
        addressRegion: 'Jakarta Barat',
        addressCountry: 'ID',
      },
      areaServed: 'ID',
      sameAs: [
        'https://instagram.com/rinisafitri988',
        'https://tiktok.com/@berkahkoper',
        'https://facebook.com/berkahkoper',
      ],
      openingHoursSpecification: {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
        opens: '08:00',
        closes: '20:00',
      },
    },
  ],
});

const navLinks = [
  { href: '/', label: 'Beranda' },
  { href: '/katalog', label: 'Katalog' },
  { href: '/#bundling', label: 'Bundling' },
  { href: '/#tentang', label: 'Tentang Kami' },
  { href: '/grosir', label: 'Grosir' },
  { href: '/kemitraan', label: 'Kemitraan' },
  { href: '/hubungi', label: 'Hubungi' },
];

const navClass =
  'inline-flex h-full items-center text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-[#4a4a4a] no-underline transition-colors hover:text-[#8a6518] aria-[current=page]:text-[#8a6518]';
const mobileNavClass =
  'block border-b border-[#e8e8e8] py-[0.95rem] text-[0.78rem] font-semibold uppercase tracking-[0.14em] text-[#4a4a4a] no-underline transition-colors hover:text-[#8a6518] aria-[current=page]:text-[#8a6518]';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.ico?v=6" sizes="any" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png?v=6" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png?v=6" />
    <link rel="apple-touch-icon" href="/favicon-192.png?v=6" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Berkah Koper" />
    <meta property="og:locale" content="id_ID" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={orgJsonLd} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    />
  </head>
  <body class="bg-white text-[#161412]">
    <header class="sticky top-0 z-50 border-b border-[#e8e8e8] bg-white">
      <div class="container-page grid h-[4.25rem] grid-cols-[1fr_auto] items-center gap-4">
        <div class="flex min-w-0 items-center justify-start">
          <a href="/" class="flex shrink-0 items-center gap-2.5 text-inherit no-underline" aria-label="Berkah Koper">
            <img src="/images/logo-96.webp?v=6" alt="Berkah Koper" class="h-8 w-8 shrink-0 object-contain" width="32" height="32" />
            <div class="leading-tight">
              <div class="text-[0.95rem] font-bold tracking-[-0.01em] text-[#161412]">Berkah Koper</div>
              <div class="whitespace-nowrap text-[0.48rem] font-bold uppercase tracking-[0.1em] text-[#8a6518] sm:text-[0.5rem] sm:tracking-[0.12em]">Supplier Perlengkapan Haji &amp; Umrah</div>
            </div>
          </a>
        </div>

        <div class="flex items-center justify-end gap-3">
          <nav class="hidden h-[4.25rem] items-stretch gap-[1.35rem] md:flex lg:gap-7" aria-label="Navigasi utama">
            {navLinks.map(({ href, label }) => (
              <a href={href} data-nav-href={href} class={navClass}>{label}</a>
            ))}
          </nav>
          <button
            id="menu-btn"
            class="inline-flex size-[2.35rem] items-center justify-center border border-[#e8e8e8] bg-white text-[#161412] transition-colors hover:border-[#c9a448] hover:text-[#8a6518] aria-expanded:border-[#c9a448] aria-expanded:text-[#8a6518] md:hidden"
            aria-label="Buka menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
            <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="hidden size-5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
          </button>
        </div>
      </div>

      <nav id="mobile-menu" class="hidden max-h-[calc(100svh-4.25rem)] overflow-y-auto border-t border-[#e8e8e8] bg-white md:hidden" aria-label="Navigasi mobile">
        <div class="container-page py-3">
          {navLinks.map(({ href, label }) => (
            <a href={href} data-nav-href={href} class={mobileNavClass}>{label}</a>
          ))}
          <a href={WA_URL} class="btn-primary mt-4 mb-3 w-full justify-center" target="_blank" rel="noopener noreferrer">Chat WhatsApp</a>
        </div>
      </nav>
    </header>

    <main id="main-content" class="bg-white">
      <slot />
    </main>

    <footer class="border-t border-[#e8e8e8] bg-white text-[#161412]">
      <div class="container-page grid items-start gap-8 py-11 sm:grid-cols-2 sm:gap-8 lg:grid-cols-[minmax(14rem,1.35fr)_repeat(3,minmax(0,11rem))] lg:justify-between lg:gap-x-8 lg:py-12">
        <div>
          <a href="/" class="flex items-center gap-2.5 text-inherit no-underline">
            <img src="/images/logo-96.webp?v=6" alt="Berkah Koper" class="size-11 object-contain" width="44" height="44" />
            <div class="leading-tight">
              <div class="text-[1.05rem] font-bold tracking-[-0.01em] text-[#161412]">Berkah Koper</div>
              <div class="whitespace-nowrap text-[0.5rem] font-bold uppercase tracking-[0.12em] text-[#8a6518]">Supplier Perlengkapan Haji &amp; Umrah</div>
            </div>
          </a>
          <p class="mt-4 max-w-[16rem] text-sm leading-6 text-[#5c5854]">
            Koper &amp; tas travel berkualitas untuk jamaah haji &amp; umrah — harga pabrik, custom logo, siap kirim.
          </p>
        </div>
        <div>
          <div class="text-[0.68rem] font-bold uppercase tracking-[0.18em] text-[#8a6518]">Produk</div>
          <ul class="mt-4 space-y-2.5 text-sm text-[#5c5854]">
            {CATALOG_CATEGORIES.map(({ value, label }) => (
              <li><a href={`/katalog?kategori=${value}`} class="text-inherit no-underline transition-colors hover:text-[#8a6518]">{label}</a></li>
            ))}
            <li><a href="/katalog" class="text-inherit no-underline transition-colors hover:text-[#8a6518]">Semua Produk →</a></li>
          </ul>
        </div>
        <div>
          <div class="text-[0.68rem] font-bold uppercase tracking-[0.18em] text-[#8a6518]">Navigasi</div>
          <ul class="mt-4 space-y-2.5 text-sm text-[#5c5854]">
            <li><a href="/" class="text-inherit no-underline transition-colors hover:text-[#8a6518]">Beranda</a></li>
            <li><a href="/katalog" class="text-inherit no-underline transition-colors hover:text-[#8a6518]">Katalog</a></li>
            <li><a href="/#bundling" class="text-inherit no-underline transition-colors hover:text-[#8a6518]">Paket Bundling</a></li>
            <li><a href="/#tentang" class="text-inherit no-underline transition-colors hover:text-[#8a6518]">Tentang Kami</a></li>
            <li><a href="/grosir" class="text-inherit no-underline transition-colors hover:text-[#8a6518]">Grosir</a></li>
            <li><a href="/kemitraan" class="text-inherit no-underline transition-colors hover:text-[#8a6518]">Kemitraan</a></li>
            <li><a href="/hubungi" class="text-inherit no-underline transition-colors hover:text-[#8a6518]">Hubungi Kami</a></li>
          </ul>
        </div>
        <div>
          <div class="text-[0.68rem] font-bold uppercase tracking-[0.18em] text-[#8a6518]">Kontak</div>
          <ul class="mt-4 space-y-3 text-sm text-[#5c5854]">
            <li>
              <div class="text-[11px] font-semibold uppercase tracking-wide text-[#7a756f]">WhatsApp</div>
              <a href={WA_URL} target="_blank" rel="noopener noreferrer" class="mt-1 inline-flex min-h-10 items-center text-[#5c5854] transition hover:text-[#8a6518]">{siteWa.display}</a>
            </li>
            <li>
              <div class="text-[11px] font-semibold uppercase tracking-wide text-[#7a756f]">Alamat</div>
              <p class="mt-0.5">Kalideres, Jakarta Barat</p>
            </li>
          </ul>
        </div>
      </div>
      <div class="border-t border-[#e8e8e8] py-4">
        <div class="container-page text-xs text-[#7a756f]">
          <span>© 2026 Berkah Koper</span>
          </div>
      </div>
    </footer>

    <a href={WA_URL} class="wa-float" target="_blank" rel="noopener noreferrer" aria-label="Chat Sekarang">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6 shrink-0" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      <span class="hidden sm:inline">Chat Sekarang</span>
    </a>

    <script>
      function syncNavActive() {
        const path = window.location.pathname.replace(/\/$/, '') || '/';
        const hash = window.location.hash;
        const onHome = path === '/';
        const onBundling = onHome && hash === '#bundling';
        const onTentang = onHome && hash === '#tentang';

        document.querySelectorAll<HTMLAnchorElement>('[data-nav-href]').forEach((link) => {
          const href = link.dataset.navHref ?? '';
          const isActive =
            href === '/#bundling' ? onBundling
            : href === '/#tentang' ? onTentang
            : href === '/' ? onHome && !onBundling && !onTentang
            : href === '/hubungi' ? path.startsWith('/hubungi')
            : href === '/katalog' ? path.startsWith('/katalog')
            : href === '/grosir' ? path.startsWith('/grosir')
            : href === '/kemitraan' ? path.startsWith('/kemitraan')
            : path.startsWith(href.replace(/\/$/, ''));

          if (isActive) link.setAttribute('aria-current', 'page');
          else link.removeAttribute('aria-current');
        });
      }

      syncNavActive();
      window.addEventListener('hashchange', syncNavActive);

      function headerOffset() {
        const header = document.querySelector<HTMLElement>('header');
        return header?.offsetHeight ?? 68;
      }

      function isSectionHash(hash: string) {
        return hash === '#bundling' || hash === '#tentang' || hash === '#mitra';
      }

      function scrollToHash(hash: string, smooth = true) {
        if (!isSectionHash(hash)) return;
        const el = document.querySelector<HTMLElement>(hash);
        if (!el) return;
        const top = Math.max(0, el.getBoundingClientRect().top + window.scrollY - headerOffset() + 2);
        window.scrollTo({ top, behavior: smooth ? 'smooth' : 'auto' });
      }

      function fixHashScroll(smooth = false) {
        if (isSectionHash(window.location.hash)) scrollToHash(window.location.hash, smooth);
      }

      document.querySelectorAll<HTMLAnchorElement>('a[href*="#bundling"], a[href*="#tentang"], a[href*="#mitra"]').forEach((link) => {
        link.addEventListener('click', (e) => {
          const url = new URL(link.href, window.location.href);
          if (url.pathname.replace(/\/$/, '') !== (window.location.pathname.replace(/\/$/, '') || '/')) return;
          const hash = url.hash;
          if (!isSectionHash(hash)) return;
          e.preventDefault();
          history.pushState(null, '', hash);
          syncNavActive();
          scrollToHash(hash, true);
          setMenu(false);
        });
      });

      fixHashScroll(false);
      requestAnimationFrame(() => fixHashScroll(false));
      window.addEventListener('load', () => fixHashScroll(false));
      document.fonts?.ready?.then(() => fixHashScroll(false));

      const btn = document.getElementById('menu-btn');
      const menu = document.getElementById('mobile-menu');
      const open = document.getElementById('icon-open');
      const close = document.getElementById('icon-close');

      function setMenu(openState: boolean) {
        if (!btn || !menu || !open || !close) return;
        btn.setAttribute('aria-expanded', String(openState));
        btn.setAttribute('aria-label', openState ? 'Tutup menu' : 'Buka menu');
        menu.classList.toggle('hidden', !openState);
        open.classList.toggle('hidden', openState);
        close.classList.toggle('hidden', !openState);
        document.body.classList.toggle('overflow-hidden', openState);
      }

      btn?.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        setMenu(!expanded);
      });

      menu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setMenu(false));
      });
    </script>
  </body>
</html>
