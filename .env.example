# --- Keystatic ---
# Dev (default): biarkan kosong → storage local, tanpa OAuth
#
# Aktifkan GitHub OAuth:
# 1. Uncomment baris di bawah, restart npm run dev
# 2. Buka http://localhost:4321/keystatic → Sign in → Create GitHub App
# 3. Keystatic akan mengisi CLIENT_ID / SECRET / SECRET / APP_SLUG ke .env
# 4. Copy semua ke Cloudflare Pages (Production + Build)
# 5. Callback URL di GitHub App (BUKAN /login):
#    http://127.0.0.1:4321/api/keystatic/github/oauth/callback
#    https://berkah-koper.pages.dev/api/keystatic/github/oauth/callback
#    /api/keystatic/github/login = tombol Sign in (redirect ke GitHub), bukan callback
#
# Rollback: hapus PUBLIC_KEYSTATIC_STORAGE (atau =local) → redeploy

# WAJIB untuk mode github (terbaca di browser + build)
# PUBLIC_KEYSTATIC_STORAGE=github

# Diisi otomatis setelah Create GitHub App (atau paste manual):
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
# PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
